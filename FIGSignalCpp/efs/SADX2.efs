const RUN0738_PARAMETERS = {
	"indicators": {
		"adxLength": 40,
		"priceMaLength": 4,
		"guideMaLength": 20,
		"guideStdDev": 0.5,
		"shockAtrLength": 7
	},
	"entry": {
		"reEntryCooldownBars": 2,
		"continuationEntryBars": 5,
		"chopMinGuideWidthAtr": 0.6,
		"chopMaxGuideSlopeAtr": 0.11,
		"startBiasShortTrend": -0.4,
		"startBiasLongTrend": -0.5
	},
	"exit": {
		"shockArmDownAtr": 2.75,
		"shockArmedRiseAtr": 2,
		"shockRiseAtr": 4.5,
		"shockRangeAtr": 2.5,
		"stopBiasShortTrend": 1.4,
		"stopBiasLongTrend": 1,
		"exitOnGuideCrossLongTrend": true
	},
	"marketTrendSettings": {
		"timeframe": "hourly",
		"smaLength": 40,
		"slopeLookback": 4,
		"slopeFlatPoints": 0.05,
		"dmiLength": 8,
		"adxLength": 18,
		"emaLength": 132,
		"atrLength": 32,
		"atrMultiplier": 2,
		"lineConfirmBars": 2,
		"sessionStartMinute": 1080,
		"sessionEndMinute": 1020,
		"timeZone": "America/New_York"
	}
}

const DEFAULT_PARAMETERS = RUN0738_PARAMETERS;

// Accept canonical grouped JSON and the previous flat PascalCase format.
// Omitted values inherit defaults; duplicate aliases and unknown keys are errors.
function ParseADXParameters(text) {
	if (text == null || (typeof text === "string" && text.trim() === "")) text = "{}";
	if (typeof text !== "string") throw new Error("LADX parameters must be a JSON string.");
	let supplied;
	try { supplied = JSON.parse(text); }
	catch (error) { throw new Error("Invalid LADX parameter JSON: " + error.message); }

	const object = value => value !== null && typeof value === "object" && !Array.isArray(value);
	if (!object(supplied)) throw new Error("ADX parameter JSON must contain an object.");
	const aliases = {
		"AdxLen": [
			"indicators",
			"adxLength"
		],
		"FastMALen": [
			"indicators",
			"priceMaLength"
		],
		"GuideMALen": [
			"indicators",
			"guideMaLength"
		],
		"GuideStdDev": [
			"indicators",
			"guideStdDev"
		],
		"ShockATRLen": [
			"indicators",
			"shockAtrLength"
		],
		"StartBias": [
			"entry",
			"startBias"
		],
		"ReEntryCooldownBars": [
			"entry",
			"reEntryCooldownBars"
		],
		"ContinuationEntryBars": [
			"entry",
			"continuationEntryBars"
		],
		"ChopMinGuideWidthATR": [
			"entry",
			"chopMinGuideWidthAtr"
		],
		"ChopMaxGuideSlopeATR": [
			"entry",
			"chopMaxGuideSlopeAtr"
		],
		"StopBias": [
			"exit",
			"stopBias"
		],
		"ShockArmDownATR": [
			"exit",
			"shockArmDownAtr"
		],
		"ShockArmedRiseATR": [
			"exit",
			"shockArmedRiseAtr"
		],
		"ShockRiseATR": [
			"exit",
			"shockRiseAtr"
		],
		"ShockRangeATR": [
			"exit",
			"shockRangeAtr"
		],
	};
	aliases.PriceMALen = aliases.FastMALen;
	["startBiasShortTrend", "startBiasLongTrend"].forEach(field => { aliases[field] = ["entry", field]; });
	["stopBiasShortTrend", "stopBiasLongTrend"].forEach(field => { aliases[field] = ["exit", field]; });
	const result = JSON.parse(JSON.stringify(DEFAULT_PARAMETERS));
	const seen = {};
	function assign(group, field, value) {
		if (group === "indicators" && field === "fastMaLength") field = "priceMaLength";
		if (group === "entry" && field === "startBias") {
			assign(group, "startBiasShortTrend", value);
			assign(group, "startBiasLongTrend", value);
			return;
		}
		if (group === "exit" && field === "stopBias") {
			assign(group, "stopBiasShortTrend", value);
			assign(group, "stopBiasLongTrend", value);
			return;
		}
		const path = group + "." + field;
		if (!Object.prototype.hasOwnProperty.call(result, group) || !Object.prototype.hasOwnProperty.call(result[group], field)) throw new Error("Unknown ADX parameter: " + path);
		if (seen[path]) throw new Error("Duplicate ADX parameter: " + path);
		seen[path] = true;
		if (group === "exit" && field === "exitOnGuideCrossLongTrend") {
			if (typeof value !== "boolean") throw new Error(path + " must be true or false.");
			result[group][field] = value;
			return;
		}
		if (typeof value !== "number" || !Number.isFinite(value)) throw new Error(path + " must be a finite number.");
		const period = group === "indicators" && ["adxLength", "priceMaLength", "guideMaLength", "shockAtrLength"].indexOf(field) >= 0;
		const count = group === "entry" && ["reEntryCooldownBars", "continuationEntryBars"].indexOf(field) >= 0;
		const minimum = period ? 1 : field === "guideStdDev" ? 0.01 : ["startBiasShortTrend", "startBiasLongTrend"].indexOf(field) >= 0 ? -10 : ["stopBiasShortTrend", "stopBiasLongTrend"].indexOf(field) >= 0 ? -100 : 0;
		if (value < minimum || ((period || count) && !Number.isSafeInteger(value))) throw new Error("Invalid value for " + path);
		result[group][field] = value;
	}
	Object.keys(supplied).forEach(key => {
		const value = supplied[key];
		if (key === "marketTrendSettings" || key === "MarketTrendSettings") {
			if (seen.marketTrendSettings) throw new Error("Duplicate marketTrendSettings");
			seen.marketTrendSettings = true;
			result.marketTrendSettings = Study_MarketTrendDaily.Settings(value, DEFAULT_PARAMETERS.marketTrendSettings);
		} else if (Object.prototype.hasOwnProperty.call(aliases,key)) {
			assign(aliases[key][0],aliases[key][1],value);
		} else if (["entry","exit","indicators"].indexOf(key) >= 0) {
			if (!object(value)) throw new Error(key + " must be an object.");
			Object.keys(value).forEach(field => assign(key,field,value[field]));
		} else throw new Error("Unknown ADX parameter: " + key);
	});
	return result;
}

const fpArray = [];
function preMain() {
	setPriceStudy(true);
	setStudyTitle("SADX");
	setColorPriceBars(true);
}

let studyCol = null;
let engine = null;
let minDateTime = 0;
let maxDateTime = 0;
let cClose = undefined;
let cHigh = undefined;
let cLow = undefined;
let pClose = undefined;
let pHigh = undefined;
let pLow = undefined;
let ppClose = undefined;
let ppHigh = undefined;
let ppLow = undefined;

function main(){
	// Initialize the TradeEngine if it is not initialized
	// and initialize the study collection and add strategies
	if (engine == null)
	{
		// default values in case if the configuration file is not provided or not defined in the config file
		const compactMode = true;
		const dataFileName = ''; // 'LC5dot1.csv' // L2dot1S100dot3.csv // LC1dot20.csv // 3Combined.csv
		const aum = 1200000;
		const multiplier = 20;
		const commission = 1.6;
		const canReinvestAUM =  false;
		// const startDateTime = new Date(2015, 0, 1, 0, 0, 0, 0);  // month is 0-based (6 is july)
		const startDateTime = new Date(2000, 0, 1, 0, 0, 0, 0);  // month is 0-based (6 is july)
		const EndDateTime = new Date(2022, 0, 1, 0, 0, 0, 0);  // month is 0-based
		// let startDateTime = new Date(2017, 12, 1, 00, 0, 0, 0);  // month is 0-based (6 is july)
		// let startDateTime = new Date(2016, 12, 1, 00, 0, 0, 0);  // month is 0-based (6 is july)

		// let startDateTime = new Date(1999, 12, 1, 00, 0, 0, 0);  // month is 0-based (6 is july)
		// let startDateTime = new Date(2022, 12, 1, 00, 0, 0, 0);  // month is 0-based (6 is july)
		minDateTime = startDateTime.getTime() / 1000;
		maxDateTime = EndDateTime.getTime() / 1000;
		maxDateTime = 0;

		debugPrint(`Parameters:    aum: ${aum}, multiplier: ${multiplier}, commission: ${commission}, canReinvestAUM: ${canReinvestAUM}\n`);
		debugPrint(`Parameters:    dataFileName: ${dataFileName.length > 0 ? dataFileName : '(empty)'}\n`);


		// initialize StudyCollection

		const studyColParams = ParseADXParameters(JSON.stringify(DEFAULT_PARAMETERS));

		debugPrint(`studyColParams:  ${JSON.stringify(studyColParams)}\n`);


		studyCol = new StudyCollection(studyColParams);

		// initialize TradeEngine
		engine = new TradeEngine(aum, multiplier, commission, dataFileName, compactMode, canReinvestAUM);

		// Add strategies to TradeEngine
		// Use default strategies in case the configuration file is not provided
		// if qty is 0 will take PercQty to calculate qty from percentage
		const defStrategies = [

			//********************Approved************************//
			// {name: "Base_L1", qty: 0, qtyPct: 1.0, enable: true, arg1: 'Mid'},
			// {name: "Dynamic_S1", qty: 0, qtyPct: 1.0, enable: true, arg1: 'Mid'},
			// {name: "Base_L1", qty: 0, qtyPct: 1.0, enable: true, arg1: 'C21'},
			// {name: "C7_L1", qty: 0, qtyPct: 1.0, enable: true, arg1: 'Mid'},
			// {name: "SCont_MAC_MAH3", qty: 0, qtyPct: 1.0, enable: true, arg1: 'Mid'},
			{name: "SADX", qty: 0, qtyPct: 1.0, enable: true, arg1: 'STrend'}
			//{name: "SBaseADX", qty: 0, qtyPct: 1.0, enable: true, arg1: 'STrend'}
		];
		defStrategies.forEach( strategyParam => {
			engine.AddStrategy(strategyParam, studyCol);
		});
	}

	// update values of studies
	cClose = close(0);
	cHigh = high(0);
	cLow = low(0);
	pClose = close(-1);
	pHigh = high(-1);
	pLow = low(-1);
	ppClose = close(-2);
	ppHigh = high(-2);
	ppLow = low(-2);

	const cTime = rawtime(0);
	if (cTime < maxDateTime || maxDateTime === 0) {
		studyCol.Calc();
	}
	if (cTime >= minDateTime && (maxDateTime === 0 || cTime < maxDateTime))
	{
		engine.ProcessOrder();   // process trading
		DrawBars();
		DrawPriceBars();
		PaintBackground();
		return CompileDataArray();
	}
}

// show data on legend dynamically, collect all strategy-based studies/data, strategy stats,
// financial data, etc. to show on the legend of the chart
let initializedLegend = false;
let studyDataList = [];
const studyColor = Color.RGB(0xFF,0x94,0xFF);

function CompileDataArray() {
	const studyDataArr = [];

	if (studyDataList.length === 0) {

		studyDataList = [
			// {	 varName: "C5MAs_UBLB_Cont_BBExit"			// variable name to be displayed
			// 	,color: studyColor
			// 	,alias: 'C5MAs_UBLB_Cont_BBExit'				// default (varName e.g. "SEMC34")... Can change the name on the legend.
			// 	,plotType: PLOTTYPE_LINE	// default(PLOTTYPE_LINE),.. Plot types: PLOTTYPE_LINE, PLOTTYPE_FLATLINES, PLOTTYPE_DOT, PLOTTYPE_SQUAREWAVE, PLOTTYPE_HISTOGRAM
			// 	,lineThickness: 2			// default(1)
			// 	,plotStyle: PS_SOLID		// default (PS_SOLID)... Plot styles: PS_SOLID, PS_DOT, PS_DASH, PS_DASHDOT, PS_DASHDOTDOT
			// 	,enable: false				// default (true)
			// }
			///todo either add here or in config file
			// {varName: "C1.MA", color: C1_color, level: "C1.MA", lineThickness: 2}
			//{varName: "L2_MAT", color: studyColor, lineThickness: 2, isText: true}
		];
	}


	// prepare labels
	if (engine.IsStarted)
	{
		if (!initializedLegend) {
			initializedLegend = true;
			let labelNdx = 0;

			// add Non-Study Data
			const outputData = engine.GetAllOutputData(engine.IsCompactMode);
			for (let key in outputData) {
				if (outputData.hasOwnProperty(key)) {
					const enable = outputData[key].enable != null ? outputData[key].enable: true;
					if (enable) {
						const plotType = outputData[key].plotType ?? PLOTTYPE_LINE;
						const plotStyle = outputData[key].plotStyle ?? PS_SOLID;
						const lineThickness =  outputData[key].lineThickness ?? 1;
						setCursorLabelName(key, labelNdx);
						const colorData = outputData[key] ? (outputData[key].color ? outputData[key].color : Color.white) : Color.white;
						setDefaultBarFgColor(colorData, labelNdx);
						setPlotType(plotType, labelNdx);
						setDefaultBarStyle(plotStyle, labelNdx);
						setDefaultBarThickness(lineThickness, labelNdx++);
					}
				}
			}

			// Monitor specific studies
			studyDataList.forEach(study => {
				const varName = study.alias ? study.alias : study.varName;
				const color = study.color ? study.color : studyColor;
				const plotType = study.plotType ? study.plotType : PLOTTYPE_LINE;
				const plotStyle = study.plotStyle ? study.plotStyle : PS_SOLID;
				const plotThickness = study.lineThickness ? study.lineThickness : 1;
				const enable = study.enable != null ? study.enable: true;
				if (enable) {
					setCursorLabelName(varName, labelNdx);
					setDefaultBarFgColor(color, labelNdx);
					setPlotType(plotType, labelNdx);
					setDefaultBarStyle(plotStyle, labelNdx);
					setDefaultBarThickness(plotThickness, labelNdx++);
				}
			});
		}

		// collect values (every bar)
		// -----------------------------
		// add Non-Study Data
		const outputData = engine.GetAllOutputData(engine.IsCompactMode);
		for (let key in outputData) {
			if (outputData.hasOwnProperty(key)) {
				const enable = outputData[key].enable != null ? outputData[key].enable: true;
				const isText = outputData[key].isText === true;
				if (enable) {
					studyDataArr.push(isText ? String(outputData[key].value) : outputData[key].value);
				}
			}
		}
		studyDataList.forEach(study => {
			study['value'] = studyCol.studies[0][study.varName];
			const enable = study.enable != null ? study.enable: true;
			const isText = study.isText === true;
			if (enable) {
				studyDataArr.push(isText ? String(study.value) : study.value);
			}
		});
	}
	return studyDataArr;
}

function PaintBackground() {
	if (!studyCol || !studyCol.studies[0]) return;
	const cStudy = studyCol.studies[0];
	const trend = cStudy.MarketTrend_READY === 1 ? cStudy.MarketTrend : 0;
	setBarBgColor(trend > 0 ? Color.RGB(0, 40, 10)
		: trend < 0 ? Color.RGB(40, 0, 10) : Color.RGB(0, 0, 0));
}

// draw bars to show when a trade is initiated and completed
function DrawBars() {
	if (engine.strategies.length <=1)
	{
		return;
	}
	let dPt = 50;
	let strategiesDir = 0;
	let ctr = 0;
	engine.strategies.forEach(strategy => {
		dPt +=25;

		if (strategy.cSide !== 0) {
			ctr++;
			const strategyDir = strategy.cSide > 0 ? 1 : strategy.cSide < 0 ? -1 : 0;
			strategiesDir += strategyDir;
			const barStats = strategy.sideDefsMap[`${strategy.cSide}`];
			if (barStats && barStats.periods.length > 0) {
				const bar = barStats.periods[barStats.periods.length-1];
				const y = strategy.cSide > 0 ? bar.low - dPt : bar.high + dPt;
				drawLineRelative(
					bar.startBar - getCurrentBarIndex(), y,
					bar.endBar- getCurrentBarIndex(), y,
					PS_SOLID, 3, barStats.color, `${strategy.label}_${strategy.cSide}_${barStats.periods.length}` );

				//const midBar = (bar.startBar + bar.endBar) / 2;
				//const startX = bar.endBar - getCurrentBarIndex() + 5;
				//const allignText = Text.LEFT;
				const startX = bar.startBar - getCurrentBarIndex() - 5;
				const alignText = Text.RIGHT;
				drawTextRelative( startX, y, `${strategy.label} ${strategy.cSide}`, barStats.color, null,
					alignText, null, null, `${strategy.label}_${strategy.cSide}_${barStats.periods.length}_text`);
			}
		}
	});

	// price bar color based on overall side
	strategiesDir = ctr === 0 ? 0 : strategiesDir / ctr;
	const color = strategiesDir > 0 && strategiesDir < 1 ? Color.yellow
		: strategiesDir < 0 && strategiesDir > -1 ? Color.orange
			: strategiesDir >= 1 ? Color.green
				: strategiesDir <= -1 ? Color.red
					: Color.white;
	setPriceBarColor(color);
}

// draw bars to show when a trade is initiated and completed
function DrawPriceBars() {
	if (engine.strategies.length > 1)
	{
		return;
	}
	const strategy = engine.strategies[0];
	const barStats = strategy.sideDefsMap[`${strategy.cSide}`];
	if (barStats) {
		setPriceBarColor(barStats.color);
	}
	else {
		setPriceBarColor(Color.white);
	}
}

function debugObj(obj, spaces = 2) {
	const seen = typeof WeakSet === "function" ? new WeakSet() : [];
	const has = (x) => seen instanceof WeakSet ? seen.has(x) : seen.indexOf(x) !== -1;
	const add = (x) => seen instanceof WeakSet ? seen.add(x) : seen.push(x);

	const replacer = (k, v) => {
		if (typeof v === "function") return `[Function ${v.name || "anonymous"}]`;
		if (v && typeof v === "object") {
			if (has(v)) return "[Circular]";
			add(v);
		}
		return v;
	};

	debugPrint(JSON.stringify(obj, replacer, spaces) + "\n");
}

/*************************************************************************************************/
/*****************  cStudyCollection - Collection of studies used in Strategies ******************/
/*************************************************************************************************/
class StudyCollection {
	constructor(params = null) {
		params = params || ParseADXParameters(null);
		// map of all studies in this collection (actual Study_[name] objects)
		this.studyList = [];

		// study maps (each map contains values for all study tags i.e. {'MAC1': 32444, 'SEMC1: 23444, etc.})
		this.studies = [{}, {}, {}];

		const priceMaLength = (params.indicators == null ? undefined : params.indicators.priceMaLength) ?? 4;
		//const slowMALen = params.SlowMALen ?? 4;
		const guideMALen = (params.indicators == null ? undefined : params.indicators.guideMaLength) ?? 8;
		const guideStdDev = (params.indicators == null ? undefined : params.indicators.guideStdDev) ?? 0.6;
		//const adxLenConf = params.AdxLenConf ?? 6;
		//const adxTriggerConf = params.AdxTriggerConf ?? 15;


		const adxLen = (params.indicators == null ? undefined : params.indicators.adxLength) ?? 50;
		this.studyList.push(new Study_SMA(priceMaLength, "ohlc4", "Price"));
		this.studyList.push(new Study_BB(guideMALen, guideStdDev, "ohlc4", "Guide", "1"));

		// Publish confirmed hourly/daily MarketTrend before downstream studies.
		// Study_SADX uses it to select entry and exit thresholds.
		const mt = Study_MarketTrendDaily.Settings(params.marketTrendSettings);
		// Lengths count completed candles of mt.timeframe, never chart bars.
		const marketSMALength = mt.smaLength;          // default 20
		const marketSlopeLookback = mt.slopeLookback; // default 5
		const marketDmiLength = mt.dmiLength;          // default 14
		const marketAdxLength = mt.adxLength;          // default 14
		const marketSlopeLabel = "MT_Slope";
		const marketAdxLabel = "MT_ADX";
		const marketSource = new Study_ClosedCandleSource(
			Math.max(marketSMALength + marketSlopeLookback, marketDmiLength + 1)
		);
		// Owned here; the aggregate pipeline drives these exactly once per
		// completed candle. Do not also add them to the chart-driven studyList.
		this.marketTrendSlope = new Study_SMASlope(
			marketSMALength, marketSlopeLookback, mt.slopeFlatPoints, marketSlopeLabel, marketSource
		);
		this.marketTrendADX = new Study_ADX(
			marketDmiLength, marketAdxLength, marketAdxLabel, marketSource
		);
		this.studyList.push(Study_MarketTrendDaily.Create(mt, "MarketTrend", {
			source: marketSource, slope: this.marketTrendSlope, adx: this.marketTrendADX,
			slopeLabel: marketSlopeLabel, adxLabel: marketAdxLabel
		}));

		this.studyList.push(new Study_ADX(adxLen, adxLen,"Active"));
		//this.studyList.push(new Study_ADX(adxLenConf, adxLenConf,"Conf"));
		//this.studyList.push(new Study_ADXROC('Active', 10, 'Active_BIAS'));
		this.studyList.push(new Study_PriceShock((params.indicators == null ? undefined : params.indicators.shockAtrLength) ?? 14, false, 'Shock'));
		// for 5 min bar
		// 1 futures day      = 276 bars
		// 2 futures days     = 552 bars
		// 1 futures week     = 276 × 5 = 1380 bars
		// 4 futures week     = 276 × 5 x 4= 5520 bars
		//
		// using one futures day back:276 for weekly
		// using one week  back:1380 for monthly
		//this.studyList.push(new Study_SMASlope(priceMaLength+6, priceMaLength, 0.1, 'SLConf'));
		this.studyList.push(new Study_SMASlope(guideMALen, 5, 0.1, 'SLGuide'));

		//this.studyList.push(new Study_SMASlope(6, 2, 0.1, 'SLHHR'));
		//this.studyList.push(new Study_SMASlope(12, 5, 0.1, 'SLHR'));
		// this.studyList.push(new Study_SMASlope(24, 10, 0.1, 'SL2HR'));
		// this.studyList.push(new Study_SMASlope(276, 23, 0.1, 'SLDAY'));
		// this.studyList.push(new Study_SMASlope(1380, 276, 0.1, 'SLWK'));
		// this.studyList.push(new Study_SMASlope(5520, 1380, 0.1, 'SLMN'));
		//this.studyList.push(new Study_VolatilityRatio(5, 48, "VOL"));

		this.studyList.push(new Study_SADX('STrend', params));
	}

	//this function is called every bar (or current bar) to calculate/refresh current values
	Calc() {
		const barState = getBarState();
		if (barState === BARSTATE_NEWBAR)
		{
			// populate new barStudies
			this.studies.pop();
			this.studies.unshift({});
		}
		this.studyList.forEach(study =>
		{
			if (barState === BARSTATE_NEWBAR) {
				if (study.studyArr) {
					study.studyArr.pop();
					study.studyArr.unshift({});
				}
			}
			if (study.studyArr) {
				study.studyArr[0] = JSON.parse(JSON.stringify(study.studyArr[1]));	// deep copy
			}
			study.Calc(this.studies)
		});
	}
}

/*************************************************************************************************/
/*****************************************  SEM  ALGO  *******************************************/
/*************************************************************************************************/
class Study_SEM {
	// can instantiate this class in the following ways
	// 		var study = new Study_SEM(13);
	//  or
	// 		var study = new Study_SEM(13, 'ohlc4');
	//  or
	// 		var study = new Study_SEM(13, 'ohlc4', 'L8');

	constructor(length, source = null, label = null) {
		this.label = label;
		this.period = length;
		this.sumX = 0;
		this.sumY = 0;
		this.sumXY = 0;
		this.sumXX = 0;
		this.initFlag = false;
		this.val = 0;
		this.pVal = 0;
		this.ppVal = 0;
		this.source = !source ? "ohlc4" : source;
		this.closeSeries = eval(`${this.source}()`);
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Calc(studies = null) {
		this.ppVal = this.pVal;
		this.pVal = this.val;

		if (this.closeSeries.getValue(-(this.period-1)) != null)
		{
			if (!this.initFlag)
			{
				this.CalcInitial();
			}
			else
			{
				this.Update();
			}
		}
		// studies is not used in this function except to update the values in case label is passed
		if (this.label && studies)
		{
			studies[0][this.Tag()] = this.val;
		}
	}

	CalcInitial() {
		this.sumX = 0;
		this.sumY = 0;
		this.sumXY = 0;
		this.sumXX = 0;
		for (let i = 0; i < this.period; i++) {
			const y = this.closeSeries.getValue(-i);
			const x = i + 1;

			this.sumX += x;
			this.sumY += y;
			this.sumXY += x * y;
			this.sumXX += x * x;
		}
		this.initFlag = true;

		const meanX = this.sumX / this.period;
		const meanY = this.sumY / this.period;

		const slope = (this.sumXY - this.sumX * meanY) / (this.sumXX - this.sumX * meanX);
		this.val = meanY - slope * meanX;  //intercept
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Update() {
		const barState = getBarState();
		if (barState === BARSTATE_NEWBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			const oldPrice = this.closeSeries.getValue(-this.period);

			this.sumXY = this.sumXY + this.sumY + (newPrice) - (oldPrice * (this.period + 1));
			this.sumY = this.sumY - oldPrice + newPrice;
		}
		else if (barState === BARSTATE_CURRENTBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			const oldPrice = this.lastPrice;

			this.sumXY = this.sumXY - oldPrice + newPrice;
			this.sumY = this.sumY - oldPrice + newPrice;
		}

		const meanX = this.sumX / this.period;
		const meanY = this.sumY / this.period;

		const slope = (this.sumXY - this.sumX * meanY) / (this.sumXX - this.sumX * meanX);
		this.val = meanY - slope * meanX;  //intercept
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Tag() {
		return Study_SEM.Label(this.label);
	}

	static Label(label) {
		return `SEM${label}`;
	}
}

/*************************************************************************************************/
/****************************************** SMA Algo *********************************************/
/*************************************************************************************************/
class Study_SMA {
	// can instantiate this class in the following ways
	// 		var study = new Study_SMA(13);
	//  or
	// 		var study = new Study_SMA(13, 'ohlc4');
	//  or
	// 		var study = new Study_SMA(13, 'ohlc4', 'L8');
	constructor(length, source = null, label = null) {
		this.label = label;
		this.period = length;
		this.runningSum = 0;
		this.initFlag = false;
		this.val = 0;
		this.pVal = 0;
		this.ppVal = 0;
		this.source = !source ? "ohlc4" : source;
		this.closeSeries = eval(`${this.source}()`);
		this.lastPrice = this.closeSeries.getValue(0)
	}

	Calc(studies = null) {
		this.ppVal = this.pVal;
		this.pVal = this.val;

		if (this.closeSeries.getValue(-(this.period-1)) != null)
		{
			if (!this.initFlag)
			{
				this.CalcInitial();
			}
			else
			{
				this.Update();
			}
		}

		// studies is not used in this function except to update the values in case label is passed
		if (this.label && studies)
		{
			studies[0][`${this.Tag()}`] = this.val;
		}
	}

	CalcInitial() {
		let sum = 0;
		for (let i = 0; i < this.period; i++) {
			sum += this.closeSeries.getValue(-i);
		}
		this.runningSum = sum;
		this.initFlag = true;
		this.val =  this.runningSum / this.period;
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Update() {
		const barState = getBarState();
		if (barState === BARSTATE_NEWBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			const oldPrice = this.closeSeries.getValue(-this.period);
			this.runningSum = this.runningSum - oldPrice + newPrice;
			this.lastPrice = newPrice;
		}
		else if (barState === BARSTATE_CURRENTBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			this.runningSum = this.runningSum - this.lastPrice + newPrice;
			this.lastPrice = newPrice;
		}
		this.val = this.runningSum / this.period;
	}

	Tag() {
		return Study_SMA.Label(this.label);
	}

	static Label(label) {
		return `MA${label}`;
	}
}

/*************************************************************************************************/
/****************************************** BB Algo  *********************************************/
/*************************************************************************************************/
class Study_BB {
	// can instantiate this class in the following ways
	// 		var study = new Study_BB(13, 1.0);
	//  or
	// 		var study = new Study_BB(13, 1.0, 'ohlc4');
	//  or
	// 		var study = new Study_BB(13, 1.0, 'ohlc4', 'L8', '1');
	constructor(length, stdDev, source = null, label = null, stdDevPrefix = null) {
		this.label = label;
		this.stdDevPrefix = stdDevPrefix;
		this.period = length;
		this.stdDev = stdDev;
		this.runningSum = 0;
		this.runningSumSquares = 0;
		this.initFlag = false;
		this.val = 0;
		this.ub = 0;
		this.lb = 0;
		this.prev_val = 0;
		this.prev_ub = 0;
		this.prev_lb = 0;
		this.pprev_val = 0;
		this.pprev_ub = 0;
		this.pprev_lb = 0;
		this.source = !source ? "ohlc4" : source;
		this.closeSeries = eval(`${this.source}()`);
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Calc(studies = null) {
		this.pprev_val = this.prev_val;
		this.pprev_ub = this.prev_ub;
		this.pprev_lb = this.prev_lb;
		this.prev_val = this.val;
		this.prev_ub = this.ub;
		this.prev_lb = this.lb;

		if (this.closeSeries.getValue(-(this.period-1)) != null)
		{
			if (!this.initFlag)
			{
				this.CalcInitial();
			}
			else
			{
				this.Update();
			}
		}

		// studies is not used in this function except to update the values in case label is passed
		if (this.label && studies)
		{
			studies[0][this.Tag('UB')] = this.ub;
			studies[0][this.Tag('LB')] = this.lb;
			studies[0][this.Tag('MID')] = this.val;
		}
	}

	CalcInitial() {
		this.runningSum = 0;
		for (let i = 0; i < this.period; i++) {
			const cPrice = this.closeSeries.getValue(-i);
			this.runningSum += cPrice;
			this.runningSumSquares += cPrice * cPrice;
		}
		this.initFlag = true;
		const sma = this.runningSum / this.period;
		const variance = (this.runningSumSquares / this.period) - (sma * sma);
		const stdDevVal = Math.sqrt(variance);
		this.val = sma;
		this.ub = sma + (this.stdDev * stdDevVal);
		this.lb = sma - (this.stdDev * stdDevVal);
		this.lastPrice = this.closeSeries.getValue(0);
	}

	Update() {
		const barState = getBarState();
		if (barState === BARSTATE_NEWBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			const oldPrice = this.closeSeries.getValue(-this.period);
			this.runningSum = this.runningSum - oldPrice + newPrice;
			this.runningSumSquares = this.runningSumSquares - (oldPrice * oldPrice) + (newPrice * newPrice);
			this.lastPrice = newPrice;
		}
		else if (barState === BARSTATE_CURRENTBAR)
		{
			const newPrice = this.closeSeries.getValue(0);
			this.runningSum = this.runningSum - this.lastPrice + newPrice;
			this.runningSumSquares = this.runningSumSquares - (this.lastPrice * this.lastPrice) + (newPrice * newPrice);
			this.lastPrice = newPrice;
		}
		const sma = this.runningSum / this.period;
		const variance = (this.runningSumSquares / this.period) - (sma * sma);
		const stdDevVal = Math.sqrt(variance);

		this.val = sma;
		this.ub = sma + (this.stdDev * stdDevVal);
		this.lb = sma - (this.stdDev * stdDevVal);
	}

	Tag(varName) {
		return Study_BB.Label(this.label, this.stdDevPrefix, varName);
	}

	static Label(label, stdDevPrefix, varName) {
		varName = varName.toUpperCase();
		const prefix = stdDevPrefix === '1' ? "" : stdDevPrefix;
		return `${varName}${prefix}${label}`;
	}
	// UB3C1
}

/*************************************************************************************************/
/***************************************** ADX Algo  *********************************************/
/*************************************************************************************************/
class Study_ADX {
	constructor(length, smoothing, label = null, source = null) {
		this.label = label;
		this.length = length;
		this.smoothing = smoothing;

		this.source = source;
		this.highSeries = source ? source.Series("high") : high();
		this.lowSeries = source ? source.Series("low") : low();
		this.closeSeries = source ? source.Series("close") : close();
		if (!Number.isSafeInteger(length) || length < 1 || !Number.isSafeInteger(smoothing) || smoothing < 1) {
			throw new Error("ADX lengths must be positive integers");
		}
		if (source && source.capacity < length + 1) throw new Error("ADX source capacity too small");
		this.Reset();
	}

	Reset() {
		this.processedCount = -1;

		// this.xATR = atr(8);

		this.initDMFlag = false;
		this.initADXFlag = false;

		this.trSum = 0;
		this.pDMSum = 0;
		this.nDMSum = 0;

		this.baseTrSum = 0;
		this.basePDMSum = 0;
		this.baseNDMSum = 0;

		this.dxQueue = [];
		this.lastADX = undefined;
		this.baseADX = undefined;

		this.liveTr = 0;
		this.livePDM = 0;
		this.liveNDM = 0;

		this.ADX = undefined;
		this.PDI = undefined;
		this.NDI = undefined;
		this.ATR = undefined;

		this.lastBarIndex = -1;
		this.lastRawTime = undefined;
		this.lastADXBarId = undefined;

	}

	Calc(studies = null) {
		// An explicit source contains only CLOSED candles. Repeated publication
		// must not advance Wilder smoothing or the ADX seed queue.
		if (this.source) {
			if (this.processedCount === this.source.count) {
				this.WriteToStudy(studies);
				return;
			}
			this.processedCount = this.source.count;
		}
		if (this.closeSeries.getValue(-1) == null) {
			this.ADX = undefined;
			this.PDI = undefined;
			this.NDI = undefined;
			this.WriteToStudy(studies);
			return;
		}

		if (!this.initDMFlag) {
			if (this.closeSeries.getValue(-this.length) == null) {
				this.ADX = undefined;
				this.PDI = undefined;
				this.NDI = undefined;
				this.ATR = undefined;
				this.WriteToStudy(studies);
				return;
			}

			this.CalcInitialDM();
			this.CalcADXFromCurrentState();
			// this.ATR = this.xATR.getValue(0);
			this.WriteToStudy(studies);
			return;
		}

		this.UpdateOptimized();
		this.CalcADXFromCurrentState();
		// this.ATR = this.xATR.getValue(0);
		this.WriteToStudy(studies);
	}

	CalcInitialDM() {
		this.trSum = 0;
		this.pDMSum = 0;
		this.nDMSum = 0;

		for (let i = 0; i < this.length; i++) {
			const vals = this.CalcBarOffsetValues(i);
			this.trSum += vals.tr;
			this.pDMSum += vals.pDM;
			this.nDMSum += vals.nDM;
		}

		this.baseTrSum = this.trSum;
		this.basePDMSum = this.pDMSum;
		this.baseNDMSum = this.nDMSum;

		this.initDMFlag = true;
		this.lastBarIndex = (this.source ? this.source.count : getCurrentBarIndex());
		this.lastRawTime = this.GetCurrentBarId();
	}

	UpdateOptimized() {
		const currentBarIndex = (this.source ? this.source.count : getCurrentBarIndex());
		const currentBarId = this.GetCurrentBarId();
		const isNewBar = currentBarId !== this.lastRawTime;

		if (isNewBar) {
			// Confirm prior bar into base state
			this.baseTrSum = this.trSum;
			this.basePDMSum = this.pDMSum;
			this.baseNDMSum = this.nDMSum;

			if (this.initADXFlag) {
				this.baseADX = this.lastADX;
			}

			this.lastBarIndex = currentBarIndex;
			this.lastRawTime = currentBarId;
		}

		const vals = this.CalcBarOffsetValues(0);
		this.liveTr = vals.tr;
		this.livePDM = vals.pDM;
		this.liveNDM = vals.nDM;

		this.trSum = this.baseTrSum - (this.baseTrSum / this.length) + this.liveTr;
		this.pDMSum = this.basePDMSum - (this.basePDMSum / this.length) + this.livePDM;
		this.nDMSum = this.baseNDMSum - (this.baseNDMSum / this.length) + this.liveNDM;
	}

	CalcADXFromCurrentState() {
		if (this.trSum <= 0 && !this.source) {
			this.ADX = undefined;
			this.PDI = undefined;
			this.NDI = undefined;
			return;
		}

		const pdi = this.trSum > 0 ? 100 * (this.pDMSum / this.trSum) : 0;
		const ndi = this.trSum > 0 ? 100 * (this.nDMSum / this.trSum) : 0;
		const diSum = pdi + ndi;

		let dx = 0;
		if (diSum > 0) {
			dx = 100 * Math.abs(pdi - ndi) / diSum;
		}

		this.PDI = pdi;
		this.NDI = ndi;

		if (!this.initADXFlag) {
			const currentBarId = this.GetCurrentBarId();
			if (this.dxQueue.length === 0 || currentBarId !== this.lastADXBarId) {
				this.dxQueue.unshift(dx);
				if (this.dxQueue.length > this.smoothing) {
					this.dxQueue.pop();
				}
				this.lastADXBarId = currentBarId;
			}
			else {
				this.dxQueue[0] = dx;
			}

			if (this.dxQueue.length < this.smoothing) {
				this.ADX = undefined;
				return;
			}

			let sum = 0;
			for (let i = 0; i < this.dxQueue.length; i++) {
				sum += this.dxQueue[i];
			}

			this.lastADX = sum / this.smoothing;
			this.baseADX = this.lastADX;
			this.ADX = this.lastADX;
			this.initADXFlag = true;
			return;
		}

		const seedADX = (this.baseADX == null) ? this.lastADX : this.baseADX;
		this.lastADX = ((seedADX * (this.smoothing - 1)) + dx) / this.smoothing;
		this.ADX = this.lastADX;
	}

	GetCurrentBarId() {
		const currentRawTime = this.source ? this.source.count : rawtime(0);
		return currentRawTime == null ? (this.source ? this.source.count : getCurrentBarIndex()) : currentRawTime;
	}

	CalcBarOffsetValues(i) {
		const currHigh = this.highSeries.getValue(-i);
		const currLow = this.lowSeries.getValue(-i);
		const currClose = this.closeSeries.getValue(-i);

		const prevHigh = this.highSeries.getValue(-(i + 1));
		const prevLow = this.lowSeries.getValue(-(i + 1));
		const prevClose = this.closeSeries.getValue(-(i + 1));

		return this.CalcDMTRValues(currHigh, currLow, currClose, prevHigh, prevLow, prevClose);
	}

	CalcDMTRValues(currHigh, currLow, currClose, prevHigh, prevLow, prevClose) {
		const upMove = currHigh - prevHigh;
		const downMove = prevLow - currLow;

		const pDM = (upMove > downMove && upMove > 0) ? upMove : 0;
		const nDM = (downMove > upMove && downMove > 0) ? downMove : 0;

		const range1 = currHigh - currLow;
		const range2 = Math.abs(currHigh - prevClose);
		const range3 = Math.abs(currLow - prevClose);
		const tr = Math.max(range1, Math.max(range2, range3));

		return { tr, pDM, nDM };
	}

	WriteToStudy(studies) {
		if (!this.label || !studies) {
			return;
		}

		if (this.source) {
			studies[0][this.Tag("READY")] = Number.isFinite(this.ADX) ? 1 : 0;
			studies[0][this.Tag("BARS")] = this.source.count;
		}
		studies[0][this.Tag("ADX")] = this.ADX;
		studies[0][this.Tag("PDI")] = this.PDI;
		studies[0][this.Tag("NDI")] = this.NDI;
		studies[0][this.Tag("BIAS")] = this.PDI - this.NDI;
	}

	Tag(varName) {
		return Study_ADX.Label(this.label, varName);
	}

	static Label(label, varName) {
		return `${label}_${varName}`;
	}
}



/*************************************************************************************************/
/******************************** ADX Rate of Change Strategy Study   ****************************/
/*************************************************************************************************/
class Study_ADXROC {
	constructor(label, numBars, studyLabel) {
		this.tag = label;
		this.studyLabel = studyLabel;

		this.slopeLength = numBars;   // number of bars to measure slope over
		this.adxHistory = [];         // newest ADX value at index 0

		this.ADX = undefined;
		this.ADX_ROC = undefined;
		this.ADX_ROC_PERCENT = undefined;
		this.ADX_SLOPE = undefined;

		this.lastSlopeBarIndex = undefined;
	}

	Calc(studies) {
		const cStudy = studies[0];
		if (cStudy == null) {
			return;
		}

		this.ADX = cStudy[this.studyLabel];

		if (this.ADX == null) {
			this.ADX_ROC = undefined;
			this.ADX_ROC_PERCENT = undefined;
			this.ADX_SLOPE = undefined;
			this.writeStudies(studies);
			return;
		}

		this.CalcADXROC();

		this.writeStudies(studies);
	}

	CalcADXROC() {
		const currentRawTime = rawtime(0);
		const currentBarId = currentRawTime == null ? getCurrentBarIndex() : currentRawTime;

		/*
			We only want one history slot per bar.

			If this is a new bar, add a new ADX value at the front.
			If this is the same live bar, update index 0 instead of adding again.
		*/
		if (this.lastSlopeBarIndex !== currentBarId) {
			this.adxHistory.unshift(this.ADX);

			if (this.adxHistory.length > this.slopeLength + 1) {
				this.adxHistory.pop();
			}

			this.lastSlopeBarIndex = currentBarId;
		} else {
			this.adxHistory[0] = this.ADX;
		}

		// Need at least current ADX and previous ADX
		if (this.adxHistory.length >= 2) {
			const prevADX = this.adxHistory[1];

			this.ADX_ROC = this.ADX - prevADX;

			if (prevADX !== 0) {
				this.ADX_ROC_PERCENT = 100 * (this.ADX - prevADX) / prevADX;
			} else {
				this.ADX_ROC_PERCENT = undefined;
			}
		} else {
			this.ADX_ROC = undefined;
			this.ADX_ROC_PERCENT = undefined;
		}

		// Need current ADX and ADX from N bars ago
		if (this.adxHistory.length > this.slopeLength) {
			const oldADX = this.adxHistory[this.slopeLength];

			this.ADX_SLOPE = (this.ADX - oldADX) / this.slopeLength;
		} else {
			this.ADX_SLOPE = undefined;
		}
	}

	writeStudies(studies) {
		const cStudy = studies[0];
		if (cStudy == null) return;

		cStudy[this.Tag('ADX_ROC')] = this.ADX_ROC;
		cStudy[this.Tag('ADX_ROC_PERCENT')] = this.ADX_ROC_PERCENT;
		cStudy[this.Tag('ADX_SLOPE')] = this.ADX_SLOPE;
	}

	Tag(varName) {
		return Study_ADXROC.Label(this.tag, varName);
	}

	static Label(tag, varName) {
		return `${tag}_${varName}`;
	}
}

/*************************************************************************************************/
/****************************************** MarketTrend Study   **********************************/
/*************************************************************************************************/
/* COMPLETE FORMULA: load on a 5-minute chart. No other file is required.
 * Daily session assumed: 18:00-17:00 America/New_York.
 * Edit internalDailySettings near the end to change the configuration. */

/*
 * Study_MarketTrend - reusable EFS study (no preMain/main in this file).
 * Directions: +1 up, -1 down, 0 neutral. Check READY before using TREND.
 *
 * Usage inside an existing EFS formula:
 *   var marketTrend = new Study_MarketTrend(20);
 *   // Call once on EVERY main() evaluation, including historical bars:
 *   var result = marketTrend.Calc(studies);
 *   var trend = studies[0][marketTrend.Tag("TREND")];
 *
 * Calc commits high/low/close(-1) on BARSTATE_NEWBAR. The confirmed signal
 * is therefore available on the FOLLOWING bar; it is never backdated.
 * Every live preview starts from committed state, so ticks cannot compound
 * smoothing or permanently confirm a swing. Call Calc before early returns.
 * Do not combine this adapter with setComputeOnClose or skip chart bars.
 *
 * Copy this file into your formula for integration, or load the supplied
 * Study_MarketTrend_Standalone.efs directly on a chart.
 * Uses class syntax, matching Study_LineTrend. Define the class before creating instances.
 */
class Study_MarketTrend {
	constructor(lenC, options, inputLabels = null) {
		this.lenC = lenC == null ? 20 : lenC;
		Study_MarketTrend._integer(this.lenC, "lenC", 1);
		this.options = Study_MarketTrend._options(options);
		this.inputLabels = inputLabels;
		if (inputLabels && (!inputLabels.slope || !inputLabels.adx || inputLabels.slope === inputLabels.adx)) {
			throw new Error("MarketTrend requires distinct slope and ADX labels");
		}
		this.Reset();
	}

	static _number(value) {
		return typeof value === "number" && isFinite(value);
	}

	static _integer(value, name, minimum) {
		if (!Study_MarketTrend._number(value) || value < minimum || Math.floor(value) !== value) {
			throw new Error("Study_MarketTrend: " + name + " must be an integer >= " + minimum);
		}
	}

	static _options(input) {
		var o = {
			slopeBars: 5, slopeEnter: 0.25, slopeExit: 0.10,
			atrLength: 14, dmiLength: 14, adxLength: 14,
			adxEnter: 25, adxExit: 20,
			swingLeft: 2, swingRight: 2,
			atrMultiplier: 1.0, lineConfirmBars: 1, minVotes: 3,
			useAdxFilter: true, confirmedOnly: true
		};
		var key;
		if (input != null) {
			if (typeof input !== "object" || input instanceof Array) {
				throw new Error("Study_MarketTrend: options must be an object");
			}
			for (key in input) {
				if (!Object.prototype.hasOwnProperty.call(input, key)) continue;
				if (!Object.prototype.hasOwnProperty.call(o, key)) {
					throw new Error("Study_MarketTrend: unknown option " + key);
				}
				o[key] = input[key];
			}
		}
		var lengths = ["slopeBars", "atrLength", "dmiLength", "adxLength", "swingLeft", "swingRight", "lineConfirmBars", "minVotes"];
		for (var i = 0; i < lengths.length; i++) {
			Study_MarketTrend._integer(o[lengths[i]], lengths[i], 1);
		}
		var thresholds = ["slopeEnter", "slopeExit", "adxEnter", "adxExit", "atrMultiplier"];
		for (i = 0; i < thresholds.length; i++) {
			key = thresholds[i];
			if (!Study_MarketTrend._number(o[key]) || o[key] < 0) {
				throw new Error("Study_MarketTrend: " + key + " must be a finite nonnegative number");
			}
		}
		if (o.slopeEnter <= 0 || o.slopeExit > o.slopeEnter || o.adxExit > o.adxEnter ||
			o.adxEnter > 100 || o.atrMultiplier <= 0 || o.minVotes > 4) {
			throw new Error("Study_MarketTrend: invalid entry/exit thresholds, ATR multiplier, or vote count");
		}
		if (typeof o.useAdxFilter !== "boolean" || typeof o.confirmedOnly !== "boolean") {
			throw new Error("Study_MarketTrend: useAdxFilter and confirmedOnly must be boolean");
		}
		return o;
	}

	static _emptyState() {
		return {
			count: 0, prevHigh: null, prevLow: null, prevClose: null,
			emaSum: 0, ema: null, emaHistory: [],
			atrSum: 0, atr: null,
			dmCount: 0, trSum: 0, plusSum: 0, minusSum: 0,
			trAverage: null, plusAverage: null, minusAverage: null,
			plusDI: null, minusDI: null, dxCount: 0, dxSum: 0, adx: null,
			bars: [], swingHigh: null, priorSwingHigh: null,
			swingLow: null, priorSwingLow: null,
			slope: null, slopeTrend: 0, swingTrend: 0, dmiTrend: 0, lineTrend: 0,
			strong: false, upper: null, lower: null, line: null,
			lineCandidate: 0, lineCount: 0,
			ready: false, trend: 0, upVotes: 0, downVotes: 0
		};
	}

	Reset() {
		this._state = Study_MarketTrend._emptyState();
		this.confirmed = this._snapshot(this._state);
		this.provisional = this._snapshot(this._state);
		// Confirmed history: latest closed bar, previous closed bar, two closes ago.
		this.studyArr = [this.confirmed, this._snapshot(this._state), this._snapshot(this._state)];
	}

	static _validBar(bar) {
		return bar != null && Study_MarketTrend._number(bar.high) &&
			Study_MarketTrend._number(bar.low) && Study_MarketTrend._number(bar.close) &&
			bar.high >= bar.low && bar.close >= bar.low && bar.close <= bar.high;
	}

	// Copy mutable arrays as well as scalars; previews must never change history.
	static _copyState(source) {
		var target = {};
		for (var key in source) {
			if (Object.prototype.hasOwnProperty.call(source, key)) {
				target[key] = source[key] instanceof Array ? source[key].slice(0) : source[key];
			}
		}
		return target;
	}

	/* Advance exactly one bar. This method is also used on a temporary copy for
     * previews. All calculations use past bars and this bar only. */
	_advance(previous, bar, inputRow) {
		var s = Study_MarketTrend._copyState(previous);
		var o = this.options;
		var h = bar.high, l = bar.low, c = bar.close;
		var tr = h - l;
		if (s.prevClose !== null) {
			tr = Math.max(tr, Math.abs(h - s.prevClose), Math.abs(l - s.prevClose));
		}
		s.count++;

		// EMA: seed with the first lenC closes, then use alpha = 2 / (lenC + 1).
		if (s.ema === null) {
			s.emaSum += c;
			if (s.count === this.lenC) s.ema = s.emaSum / this.lenC;
		} else {
			s.ema += (2 / (this.lenC + 1)) * (c - s.ema);
		}
		if (s.ema !== null) {
			s.emaHistory.push(s.ema);
			if (s.emaHistory.length > o.slopeBars + 1) s.emaHistory.shift();
		}

		// ATR: seed with mean TR (first bar uses high-low), then Wilder smoothing.
		if (s.atr === null) {
			s.atrSum += tr;
			if (s.count === o.atrLength) s.atr = s.atrSum / o.atrLength;
		} else {
			s.atr += (tr - s.atr) / o.atrLength;
		}

		if (!this.inputLabels) {
			// DMI uses bar-to-bar transitions. Equal positive moves contribute neither
			// +DM nor -DM. Its own TR smoothing uses the SAME transition sample window.
			if (s.prevClose !== null) {
				var upMove = h - s.prevHigh;
				var downMove = s.prevLow - l;
				var plusDM = upMove > downMove && upMove > 0 ? upMove : 0;
				var minusDM = downMove > upMove && downMove > 0 ? downMove : 0;
				s.dmCount++;
				if (s.trAverage === null) {
					s.trSum += tr;
					s.plusSum += plusDM;
					s.minusSum += minusDM;
					if (s.dmCount === o.dmiLength) {
						s.trAverage = s.trSum / o.dmiLength;
						s.plusAverage = s.plusSum / o.dmiLength;
						s.minusAverage = s.minusSum / o.dmiLength;
					}
				} else {
					s.trAverage += (tr - s.trAverage) / o.dmiLength;
					s.plusAverage += (plusDM - s.plusAverage) / o.dmiLength;
					s.minusAverage += (minusDM - s.minusAverage) / o.dmiLength;
				}
				if (s.trAverage !== null) {
					s.plusDI = s.trAverage > 0 ? 100 * s.plusAverage / s.trAverage : 0;
					s.minusDI = s.trAverage > 0 ? 100 * s.minusAverage / s.trAverage : 0;
					var diTotal = s.plusDI + s.minusDI;
					var dx = diTotal > 0 ? 100 * Math.abs(s.plusDI - s.minusDI) / diTotal : 0;
					if (s.adx === null) {
						s.dxSum += dx;
						s.dxCount++;
						if (s.dxCount === o.adxLength) s.adx = s.dxSum / o.adxLength;
					} else {
						s.adx += (dx - s.adx) / o.adxLength;
					}
				}
			}

			// 1. EMA slope in ATR units over slopeBars (not per bar).
			// Entry requires the larger threshold; an existing direction can persist
			// down to the smaller exit threshold while price remains on its EMA side.
			s.slope = null;
			s.slopeTrend = 0;
			if (s.atr !== null && s.emaHistory.length === o.slopeBars + 1) {
				s.slope = s.atr > 0 ? (s.ema - s.emaHistory[0]) / s.atr : 0;
				s.slopeTrend = this._slopeDirection(previous.slopeTrend, c, s.ema, s.slope);
			}

		} else {
			var labels = this.inputLabels;
			if (!inputRow || !Object.prototype.hasOwnProperty.call(inputRow, labels.slope + "_READY") ||
				!Object.prototype.hasOwnProperty.call(inputRow, labels.adx + "_READY")) {
				throw new Error("MarketTrend input labels missing from completed-candle row");
			}
			var slopeReady = inputRow[labels.slope + "_READY"] === 1;
			var adxReady = inputRow[labels.adx + "_READY"] === 1;
			s.slope = slopeReady ? inputRow[labels.slope + "_MASlopeValue"] : null;
			s.slopeTrend = slopeReady ? inputRow[labels.slope + "_MASlope"] : 0;
			s.adx = adxReady ? inputRow[labels.adx + "_ADX"] : null;
			s.plusDI = adxReady ? inputRow[labels.adx + "_PDI"] : null;
			s.minusDI = adxReady ? inputRow[labels.adx + "_NDI"] : null;
		}

		// 2. Confirmed swings. The candidate has swingLeft older bars and
		// swingRight later bars. Tied highs/lows are deliberately not pivots.
		// Record the pivot only NOW, at confirmation, never on the candidate bar.
		var windowSize = o.swingLeft + o.swingRight + 1;
		s.bars.push({ high: h, low: l });
		if (s.bars.length > windowSize) s.bars.shift();
		if (s.bars.length === windowSize) {
			var candidate = s.bars[o.swingLeft];
			var isHigh = true, isLow = true;
			for (var i = 0; i < windowSize; i++) {
				if (i === o.swingLeft) continue;
				if (candidate.high <= s.bars[i].high) isHigh = false;
				if (candidate.low >= s.bars[i].low) isLow = false;
			}
			if (isHigh) {
				s.priorSwingHigh = s.swingHigh;
				s.swingHigh = candidate.high;
			}
			if (isLow) {
				s.priorSwingLow = s.swingLow;
				s.swingLow = candidate.low;
			}
		}
		s.swingTrend = 0;
		if (s.priorSwingHigh !== null && s.priorSwingLow !== null) {
			if (s.swingHigh > s.priorSwingHigh && s.swingLow > s.priorSwingLow && c >= s.swingLow) {
				s.swingTrend = 1;
			} else if (s.swingHigh < s.priorSwingHigh && s.swingLow < s.priorSwingLow && c <= s.swingHigh) {
				s.swingTrend = -1;
			}
		}

		// 3. DMI direction, qualified by ADX strength with entry/exit hysteresis.
		// ADX falling does not itself imply a downward price trend.
		s.strong = s.adx !== null && s.adx >= (previous.strong ? o.adxExit : o.adxEnter);
		s.dmiTrend = 0;
		if (s.strong) {
			s.dmiTrend = s.plusDI > s.minusDI ? 1 : (s.minusDI > s.plusDI ? -1 : 0);
		}

		// 4. EMA +/- ATR buffer. A close beyond a band establishes that direction.
		// Require lineConfirmBars consecutive closes beyond the same band.
		// An inside-band close or return to the existing direction resets the
		// pending count. Previews cannot advance the committed count.
		// Inside the bands, retain the previous direction. This is an EMA channel,
		// not a ratcheting trailing stop or the standard Supertrend formula.
		if (s.ema !== null && s.atr !== null) {
			s.upper = s.ema + o.atrMultiplier * s.atr;
			s.lower = s.ema - o.atrMultiplier * s.atr;
			var candidateDirection = c > s.upper ? 1 : (c < s.lower ? -1 : 0);
			if (s.atr <= 0) {
				s.lineTrend = 0;
				s.lineCandidate = 0;
				s.lineCount = 0;
			} else if (candidateDirection !== 0 && candidateDirection !== s.lineTrend) {
				s.lineCount = candidateDirection === previous.lineCandidate ? previous.lineCount + 1 : 1;
				s.lineCandidate = candidateDirection;
				if (s.lineCount >= o.lineConfirmBars) {
					s.lineTrend = candidateDirection;
					s.lineCandidate = 0;
					s.lineCount = 0;
				}
			} else {
				s.lineCandidate = 0;
				s.lineCount = 0;
			}
			s.line = s.lineTrend === 1 ? s.lower : (s.lineTrend === -1 ? s.upper : null);
		}

		// Equal votes: slope, swings, DMI, buffered line. Missing swing structure
		// abstains (0), allowing the other three to agree in a smooth trend.
		var votes = [s.slopeTrend, s.swingTrend, s.dmiTrend, s.lineTrend];
		s.upVotes = 0;
		s.downVotes = 0;
		for (var v = 0; v < votes.length; v++) {
			if (votes[v] === 1) s.upVotes++;
			if (votes[v] === -1) s.downVotes++;
		}
		s.ready = s.ema !== null && s.slope !== null && s.adx !== null && s.atr !== null;
		s.trend = 0;
		if (s.ready && (!o.useAdxFilter || s.strong)) {
			if (s.upVotes >= o.minVotes && s.upVotes > s.downVotes) s.trend = 1;
			else if (s.downVotes >= o.minVotes && s.downVotes > s.upVotes) s.trend = -1;
		}

		s.prevHigh = h;
		s.prevLow = l;
		s.prevClose = c;
		return s;
	}

	_slopeDirection(prior, price, average, slope) {
		var o = this.options;
		if (price > average && slope > o.slopeEnter) return 1;
		if (price < average && slope < -o.slopeEnter) return -1;
		if (prior === 1 && price >= average && slope >= o.slopeExit) return 1;
		if (prior === -1 && price <= average && slope <= -o.slopeExit) return -1;
		return 0;
	}

	_snapshot(s) {
		return {
			TREND: s.trend, READY: s.ready ? 1 : 0, BARS: s.count,
			EMA: s.ema, ATR: s.atr, SLOPE: s.slope,
			ADX: s.adx, PLUS_DI: s.plusDI, MINUS_DI: s.minusDI,
			STRONG: s.strong ? 1 : 0,
			SLOPE_TREND: s.slopeTrend, SWING_TREND: s.swingTrend,
			DMI_TREND: s.dmiTrend, LINE_TREND: s.lineTrend,
			UPPER: s.upper, LOWER: s.lower, LINE: s.line,
			SWING_HIGH: s.swingHigh, PRIOR_SWING_HIGH: s.priorSwingHigh,
			SWING_LOW: s.swingLow, PRIOR_SWING_LOW: s.priorSwingLow,
			UP_VOTES: s.upVotes, DOWN_VOTES: s.downVotes,
			SCORE: s.upVotes - s.downVotes
		};
	}

	// Direct API for replay/testing: call exactly once per completed bar, oldest
	// to newest. Do not mix direct commits with Calc on the same instance.
	UpdateClosed(bar, inputRow) {
		if (!Study_MarketTrend._validBar(bar)) {
			throw new Error("Study_MarketTrend: invalid completed OHLC bar");
		}
		this._state = this._advance(this._state, bar, inputRow);
		this.confirmed = this._snapshot(this._state);
		this.studyArr.unshift(this.confirmed);
		this.studyArr.pop();
		return this.confirmed;
	}

	Preview(bar) {
		if (this.inputLabels) throw new Error("Label-driven MarketTrend accepts completed candles only");
		if (!Study_MarketTrend._validBar(bar)) {
			throw new Error("Study_MarketTrend: invalid provisional OHLC bar");
		}
		this.provisional = this._snapshot(this._advance(this._state, bar));
		return this.provisional;
	}

	Calc(studies) {
		if (studies != null && (studies[0] == null || typeof studies[0] !== "object")) {
			throw new Error("Study_MarketTrend: studies[0] must be an output object");
		}
		var state = getBarState();
		if (state === BARSTATE_ALLBARS) this.Reset();
		if (state === BARSTATE_NEWBAR) {
			var closedBar = { high: high(-1), low: low(-1), close: close(-1) };
			// Null history is normal at the start of a chart. Reset on a gap so
			// that stale state cannot silently bridge unavailable price data.
			if (Study_MarketTrend._validBar(closedBar)) this.UpdateClosed(closedBar);
			else this.Reset();
		}
		var liveBar = { high: high(0), low: low(0), close: close(0) };
		if (Study_MarketTrend._validBar(liveBar)) this.Preview(liveBar);
		else this.provisional = this._snapshot(Study_MarketTrend._emptyState());

		var selected = this.options.confirmedOnly ? this.confirmed : this.provisional;
		if (studies != null) {
			for (var key in selected) {
				if (Object.prototype.hasOwnProperty.call(selected, key)) studies[0][this.Tag(key)] = selected[key];
			}
			studies[0][this.Tag("CONFIRMED")] = this.confirmed.TREND;
			studies[0][this.Tag("PROVISIONAL")] = this.provisional.TREND;
			studies[0][this.Tag("CONFIRMED_READY")] = this.confirmed.READY;
			studies[0][this.Tag("PROVISIONAL_READY")] = this.provisional.READY;
		}
		return selected;
	}

	Tag(varName) {
		return Study_MarketTrend.Label(this.lenC, varName);
	}

	static Label(lenC, varName) {
		var name = String(varName).toUpperCase();
		var names = "|TREND|READY|BARS|EMA|ATR|SLOPE|ADX|PLUS_DI|MINUS_DI|STRONG|" +
			"SLOPE_TREND|SWING_TREND|DMI_TREND|LINE_TREND|UPPER|LOWER|LINE|" +
			"SWING_HIGH|PRIOR_SWING_HIGH|SWING_LOW|PRIOR_SWING_LOW|UP_VOTES|DOWN_VOTES|SCORE|" +
			"CONFIRMED|PROVISIONAL|CONFIRMED_READY|PROVISIONAL_READY|";
		if (name.indexOf("|") >= 0 || names.indexOf("|" + name + "|") < 0) {
			throw new Error("Study_MarketTrend: unsupported label " + name);
		}
		return lenC + "_MT" + (name === "TREND" ? "" : "_" + name);
	}
}


/* Builds session OHLC from consecutive COMPLETED intraday candles.
 * Requires Study_MarketTrend to be defined first. No secondary data series.
 * Default session: 18:00 through 17:00 next day, America/New_York.
 * Timestamps are Unix seconds (EFS rawtime), independent of PC/chart timezone.
 */
class Study_SessionDailyBuilder {
	constructor(study, startMinute, endMinute, timeZone) {
		if (!study || typeof study.UpdateClosed !== "function") {
			throw new Error("Daily builder: a Study_MarketTrend instance is required");
		}
		this.study = study;
		this.startMinute = startMinute;
		this.endMinute = endMinute;
		this.timeZone = timeZone;
		Study_MarketTrend._integer(startMinute, "session start minute", 0);
		Study_MarketTrend._integer(endMinute, "session end minute", 0);
		if (startMinute >= 1440 || endMinute >= 1440) {
			throw new Error("Daily builder: session times must be within a day");
		}
		if (timeZone !== "America/New_York" && timeZone !== "UTC") {
			throw new Error("Daily builder: supported time zones are America/New_York and UTC");
		}
		this.duration = (endMinute - startMinute + 1440) % 1440 || 1440;
		this.Reset();
	}

	Reset() {
		this.study.Reset();
		this.active = null;
		this.lastDaily = null;
		this.lastInputTime = null;
		this.lastFinishedKey = null;
		this.seenSession = false;
		this.skippedInitialSessions = 0;
		this._dstYear = null;
	}

	_offsetMinutes(milliseconds) {
		if (this.timeZone === "UTC") return 0;
		var year = new Date(milliseconds).getUTCFullYear();
		if (year < 2007) {
			throw new Error("Daily builder: New York timezone supports 2007 onward; shorten chart history");
		}
		// US rules since 2007: second Sunday in March, first Sunday in November.
		// Start is 02:00 EST (07:00 UTC); end is 02:00 EDT (06:00 UTC).
		if (year !== this._dstYear) {
			var marchFirst = new Date(Date.UTC(year, 2, 1)).getUTCDay();
			var novemberFirst = new Date(Date.UTC(year, 10, 1)).getUTCDay();
			this._dstStart = Date.UTC(year, 2, 8 + (7 - marchFirst) % 7, 7);
			this._dstEnd = Date.UTC(year, 10, 1 + (7 - novemberFirst) % 7, 6);
			this._dstYear = year;
		}
		return milliseconds >= this._dstStart && milliseconds < this._dstEnd ? -240 : -300;
	}

	SessionInfo(seconds) {
		if (!Study_MarketTrend._number(seconds) || !isFinite(new Date(seconds * 1000).getTime())) {
			throw new Error("Daily builder: invalid bar timestamp");
		}
		var milliseconds = seconds * 1000;
		var localMilliseconds = milliseconds + this._offsetMinutes(milliseconds) * 60000;
		var local = new Date(localMilliseconds);
		var minute = local.getUTCHours() * 60 + local.getUTCMinutes();
		var elapsed = (minute - this.startMinute + 1440) % 1440;
		return {
			// Integer civil-day key, anchored at the session's local start.
			key: Math.floor((localMilliseconds - this.startMinute * 60000) / 86400000),
			inSession: elapsed < this.duration,
			atStart: elapsed === 0 && local.getUTCSeconds() === 0,
			minute: minute
		};
	}

	_finish() {
		if (this.active === null) return;
		var a = this.active;
		if (a.include) {
			var daily = { open: a.open, high: a.high, low: a.low, close: a.close };
			this.study.UpdateClosed(daily);
			// Diagnostics: raw aggregation, without settlement-price substitution.
			this.lastDaily = {
				open: a.open, high: a.high, low: a.low, close: a.close,
				sessionKey: a.key, sourceBars: a.sourceBars
			};
		} else {
			this.skippedInitialSessions++;
		}
		this.lastFinishedKey = a.key;
		this.active = null;
	}

	AdvanceClock(seconds) {
		var info = this.SessionInfo(seconds);
		// Only called after all previous completed intraday bars are ingested.
		// A new session (including after a weekend) or a maintenance-break bar
		// makes the old daily candle available. No empty days are fabricated.
		if (this.active !== null &&
			(info.key > this.active.key || (info.key === this.active.key && !info.inSession))) {
			this._finish();
		}
		return this.study.confirmed;
	}

	PushClosed(seconds, bar) {
		var info = this.SessionInfo(seconds);
		if (!Study_MarketTrend._validBar(bar) || !Study_MarketTrend._number(bar.open) ||
			bar.open < bar.low || bar.open > bar.high) {
			throw new Error("Daily builder: invalid completed intraday OHLC");
		}
		if (this.lastInputTime !== null) {
			if (seconds === this.lastInputTime) return this.study.confirmed;
			if (seconds < this.lastInputTime) {
				throw new Error("Daily builder: bars must be supplied oldest to newest");
			}
		}
		this.AdvanceClock(seconds);
		this.lastInputTime = seconds;
		if (!info.inSession) return this.study.confirmed;
		if (this.lastFinishedKey !== null && info.key <= this.lastFinishedKey) {
			throw new Error("Daily builder: cannot append to an already completed session");
		}
		if (this.active === null) {
			this.active = {
				key: info.key, open: bar.open, high: bar.high, low: bar.low,
				close: bar.close, sourceBars: 1,
				// The first loaded session is discarded if history starts midway.
				include: this.seenSession || info.atStart
			};
			this.seenSession = true;
		} else {
			this.active.high = Math.max(this.active.high, bar.high);
			this.active.low = Math.min(this.active.low, bar.low);
			this.active.close = bar.close;
			this.active.sourceBars++;
		}
		return this.study.confirmed;
	}
}


/*************************************************************************************************/
/******************************** Price Shock / Velocity Study   *********************************/
/*************************************************************************************************/
/* Internally builds clock-hour OHLC from completed chart candles.
 * Requires Study_SessionDailyBuilder (session filtering and timestamp handling).
 * New York and UTC have whole-hour offsets, so Unix hour boundaries also match
 * their local clock hours. Absolute keys keep repeated DST hours distinct.
 * No synthetic bars are created for maintenance breaks or missing hours.
 */
class Study_SessionHourlyBuilder extends Study_SessionDailyBuilder {
	constructor(study, startMinute, endMinute, timeZone) {
		super(study, startMinute, endMinute, timeZone);
		if (startMinute % 60 !== 0 || endMinute % 60 !== 0) {
			throw new Error("Hourly MarketTrend requires session boundaries on whole hours");
		}
	}

	Reset() {
		super.Reset();
		this.lastHourly = null;
	}

	SessionInfo(seconds) {
		const session = super.SessionInfo(seconds);
		return {
			key: Math.floor(seconds / 3600),
			inSession: session.inSession,
			atStart: seconds % 3600 === 0,
			minute: session.minute
		};
	}

	_finish() {
		super._finish();
		if (this.lastDaily !== null) {
			this.lastHourly = {
				open: this.lastDaily.open, high: this.lastDaily.high,
				low: this.lastDaily.low, close: this.lastDaily.close,
				hourKey: this.lastDaily.sessionKey, sourceBars: this.lastDaily.sourceBars
			};
		}
	}
}


/* A bounded, explicit OHLC source for reusable studies. No inv() or live ticks.
 * PushClosed is called once per completed aggregate, oldest to newest.
 * Series offsets use EFS convention: 0 is newest, -1 is previous.
 */
class Study_ClosedCandleSource {
	constructor(capacity) {
		Study_MarketTrend._integer(capacity, "closed candle capacity", 2);
		this.capacity = capacity;
		this.Reset();
	}

	Reset() { this.bars = []; this.count = 0; }

	PushClosed(bar) {
		if (!Study_MarketTrend._validBar(bar)) throw new Error("Invalid closed source candle");
		this.bars.unshift({ open: bar.open, high: bar.high, low: bar.low, close: bar.close });
		if (this.bars.length > this.capacity) this.bars.pop();
		this.count++;
	}

	Series(field) {
		return { getValue: offset => {
				const bar = this.bars[-(offset || 0)];
				return bar ? bar[field] : null;
			} };
	}

	SMA(length) {
		return { getValue: offset => {
				const start = -(offset || 0);
				if (start < 0 || start + length > this.bars.length) return null;
				let sum = 0;
				for (let i = start; i < start + length; i++) sum += this.bars[i].close;
				return sum / length;
			} };
	}
}

/* Drives a set of reusable studies BEFORE their consumer, for EACH completed
 * aggregate (even when a gap causes two aggregates to close in one callback).
 * Its private row is republished by the adapter on every chart evaluation.
 */
class Study_MarketTrendInputPipeline {
	constructor(trend, inputs, onConfirmed = null) {
		this.trend = trend;
		this.inputs = inputs;
		this.onConfirmed = onConfirmed;
		this.Reset();
	}

	get confirmed() { return this.trend.confirmed; }

	Reset() {
		this.inputs.source.Reset();
		this.inputs.adx.Reset();
		this.trend.Reset();
		if (this.onConfirmed) this.onConfirmed(this.trend.confirmed);
		this.rows = [{}];
		this.inputs.slope.Calc(this.rows);
		this.inputs.adx.Calc(this.rows);
	}

	UpdateClosed(bar) {
		this.inputs.source.PushClosed(bar);
		this.rows = [{}];
		this.inputs.slope.Calc(this.rows);
		this.inputs.adx.Calc(this.rows);
		const result = this.trend.UpdateClosed(bar, this.rows[0]);
		if (this.onConfirmed) this.onConfirmed(result);
		return result;
	}
}

/* Study_MarketTrendDaily: Adapter for the internally aggregated DAILY MarketTrend.
 * Requires Study_MarketTrend and Study_SessionDailyBuilder.
 * Add this adapter to studyList before studies that may consume its outputs.
 * Publishes the combined confirmed TREND, not LINE_TREND.
 */
class Study_MarketTrendDaily {
	constructor(settings, label = "MarketTrend", inputs = null) {
		this.tag = label;
		this.inputs = inputs;
		if (inputs && (inputs.slope.source !== inputs.source || inputs.adx.source !== inputs.source ||
			inputs.slope.tag !== inputs.slopeLabel || inputs.adx.label !== inputs.adxLabel)) {
			throw new Error("MarketTrend input source or label mismatch");
		}
		this.settings = Study_MarketTrendDaily.Settings(settings);
		this.timeframe = "daily";
		this.lastDirection = 0;
		const cfg = this.settings;
		const interval = Number(getInterval());
		if (!Number.isFinite(interval) || interval < 1 || interval >= 1440 ||
			Math.floor(interval) !== interval || 1440 % interval !== 0 ||
			cfg.sessionStartMinute % interval !== 0 || cfg.sessionEndMinute % interval !== 0) {
			throw new Error("MarketTrend: use aligned intraday minute bars, such as 2, 5, 15, 30 or 60");
		}
		this.study = new Study_MarketTrend(cfg.emaLength, {
			atrLength: cfg.atrLength,
			atrMultiplier: cfg.atrMultiplier,
			lineConfirmBars: cfg.lineConfirmBars,
			confirmedOnly: true
		}, inputs ? { slope: inputs.slopeLabel, adx: inputs.adxLabel } : null);
		this.sink = inputs ? new Study_MarketTrendInputPipeline(
			this.study, inputs, result => this.ResolveDirection(result)
		) : this.study;
		this.builder = this.CreateBuilder(cfg);
		// Deliberately no studyArr here. StudyCollection shifts studyArr on
		// every INTRADAY bar, while this study owns its DAILY history itself.
	}

	CreateBuilder(cfg) {
		return new Study_SessionDailyBuilder(
			this.sink, cfg.sessionStartMinute, cfg.sessionEndMinute, cfg.timeZone
		);
	}

	// Selection belongs to the collection. Direct construction of Daily or
	// Hourly always uses the timeframe named by that class.
	static Create(settings, label = "MarketTrend", inputs = null) {
		const cfg = Study_MarketTrendDaily.Settings(settings);
		return cfg.timeframe === "hourly"
			? new Study_MarketTrendHourly(cfg, label, inputs)
			: new Study_MarketTrendDaily(cfg, label, inputs);
	}

	static Settings(supplied, defaults) {
		const fallback = defaults || {
			emaLength: 50, atrLength: 20, atrMultiplier: 2.0, lineConfirmBars: 2,
			sessionStartMinute: 18 * 60, sessionEndMinute: 17 * 60,
			timeZone: "America/New_York", timeframe: "daily"
		};
		if (supplied === undefined) supplied = {};
		if (supplied === null || Array.isArray(supplied) || typeof supplied !== "object") {
			throw new Error("MarketTrendSettings must be an object");
		}
		const result = {};
		const names = ["emaLength", "atrLength", "atrMultiplier", "lineConfirmBars",
			"sessionStartMinute", "sessionEndMinute", "timeZone", "timeframe",
			"smaLength", "slopeLookback", "slopeFlatPoints", "dmiLength", "adxLength"];
		names.forEach(key => { result[key] = fallback[key]; });
		// Older settings objects keep their daily behavior when the field is omitted.
		if (result.timeframe === undefined) result.timeframe = "daily";
		Object.keys(supplied).forEach(key => {
			if (names.indexOf(key) < 0) throw new Error("Unknown MarketTrendSettings field: " + key);
			result[key] = supplied[key];
		});
		if (result.smaLength === undefined) result.smaLength = 20;
		if (result.slopeLookback === undefined) result.slopeLookback = 5;
		if (result.slopeFlatPoints === undefined) result.slopeFlatPoints = 0.1;
		if (result.dmiLength === undefined) result.dmiLength = 14;
		if (result.adxLength === undefined) result.adxLength = 14;
		if (!Number.isFinite(result.slopeFlatPoints) || result.slopeFlatPoints < 0) {
			throw new Error("MarketTrendSettings.slopeFlatPoints must be finite and nonnegative");
		}
		["emaLength", "atrLength", "lineConfirmBars", "smaLength", "slopeLookback", "dmiLength", "adxLength"].forEach(key => {
			if (!Number.isSafeInteger(result[key]) || result[key] < 1) {
				throw new Error("MarketTrendSettings." + key + " must be a positive integer");
			}
		});
		if (typeof result.atrMultiplier !== "number" || !Number.isFinite(result.atrMultiplier) || result.atrMultiplier <= 0) {
			throw new Error("MarketTrendSettings.atrMultiplier must be a positive finite number");
		}
		["sessionStartMinute", "sessionEndMinute"].forEach(key => {
			if (!Number.isSafeInteger(result[key]) || result[key] < 0 || result[key] >= 1440) {
				throw new Error("MarketTrendSettings." + key + " must be an integer from 0 to 1439");
			}
		});
		if (result.timeZone !== "America/New_York" && result.timeZone !== "UTC") {
			throw new Error("MarketTrendSettings.timeZone must be America/New_York or UTC");
		}
		if (result.timeframe !== "daily" && result.timeframe !== "hourly") {
			throw new Error("MarketTrendSettings.timeframe must be daily or hourly");
		}
		return result;
	}

	Calc(studies) {
		if (!studies || !studies[0]) throw new Error("MarketTrend requires studies[0]");
		const barState = getBarState();
		if (barState === BARSTATE_ALLBARS) this.builder.Reset();
		if (barState === BARSTATE_NEWBAR) {
			const time = getValue("rawtime", -1);
			const bar = { open: open(-1), high: high(-1), low: low(-1), close: close(-1) };
			if (Study_MarketTrend._number(time) && Study_MarketTrend._validBar(bar) &&
				Study_MarketTrend._number(bar.open) && bar.open >= bar.low && bar.open <= bar.high) {
				this.builder.PushClosed(time, bar);
			} else {
				this.builder.Reset();
			}
			const currentTime = getValue("rawtime", 0);
			if (Study_MarketTrend._number(currentTime)) this.builder.AdvanceClock(currentTime);
		}

		// Publish on EVERY evaluation, including live ticks. StudyCollection
		// creates a fresh row each chart bar; the same daily value belongs in it.
		const result = this.study.confirmed;
		const cStudy = studies[0];
		if (this.inputs) Object.assign(cStudy, this.sink.rows[0]);
		cStudy[this.Tag()] = this.ResolveDirection(result);
		cStudy[this.Tag("RAW_TREND")] = result.TREND;
		cStudy[this.Tag("READY")] = result.READY;
		cStudy[this.Tag("BARS")] = result.BARS;
		cStudy[this.Tag("TIMEFRAME")] = this.timeframe;
		cStudy[this.Tag("DAILY_BARS")] = this.timeframe === "daily" ? result.BARS : 0;
		cStudy[this.Tag("HOURLY_BARS")] = this.timeframe === "hourly" ? result.BARS : 0;
		["EMA", "ATR", "ADX", "SLOPE", "SCORE", "UP_VOTES", "DOWN_VOTES",
			"SLOPE_TREND", "SWING_TREND", "DMI_TREND"].forEach(name => {
			cStudy[this.Tag(name)] = result[name];
		});
		return Object.assign({}, result, {
			RAW_TREND: result.TREND, TREND: cStudy[this.Tag()]
		});
	}

	// A neutral consensus takes the direction with more component votes.
	// Ties retain the prior direction to avoid arbitrary oscillation.
	ResolveDirection(result) {
		if (!result.READY) {
			this.lastDirection = 0;
			return 0;
		}
		let direction = result.TREND;
		if (direction === 0) {
			const balance = result.UP_VOTES - result.DOWN_VOTES;
			direction = balance > 0 ? 1 : balance < 0 ? -1 : this.lastDirection;
			// First ready candle has no prior direction: use the selected slope.
			// An exactly flat initial tie defaults to long deterministically.
			if (direction === 0) direction = result.SLOPE < 0 ? -1 : 1;
		}
		this.lastDirection = direction;
		return direction;
	}

	Tag(name = "TREND") {
		return Study_MarketTrendDaily.Label(this.tag, name);
	}

	static Label(label, name = "TREND") {
		name = String(name).toUpperCase();
		return name === "TREND" ? label : label + "_" + name;
	}
}

/* Study_MarketTrendHourly: Same outputs and bar-state behavior as Study_MarketTrendDaily,
 * with internally aggregated hourly candles instead of daily candles.
 * Requires Study_MarketTrendDaily and Study_SessionHourlyBuilder.
 */
class Study_MarketTrendHourly extends Study_MarketTrendDaily {
	constructor(settings, label = "MarketTrend", inputs = null) {
		super(settings, label, inputs);
		this.timeframe = "hourly";
	}

	CreateBuilder(cfg) {
		const interval = Number(getInterval());
		if (!Number.isSafeInteger(interval) || interval < 1 || interval > 60 || 60 % interval !== 0) {
			throw new Error("Hourly MarketTrend requires minute charts that divide 60, such as 2, 5, 15, 30 or 60");
		}
		return new Study_SessionHourlyBuilder(
			this.sink, cfg.sessionStartMinute, cfg.sessionEndMinute, cfg.timeZone
		);
	}
}


class Study_PriceShock {
	constructor(atrLen = 14, upward = true, label = null) {
		this.tag = label;
		this.xATR = atr(atrLen);

		this.ATR = undefined;
		this.DownPoints = 0;
		this.UpPoints = 0;
		this.RangePoints = 0;
		this.PullbackPoints = 0;
		this.DownATR = 0;
		this.UpATR = 0;
		this.RangeATR = 0;
		this.PullbackATR = 0;
		this.ShockScore = 0;

		this.Upward = upward;
	}

	Calc(studies) {
		this.ATR = this.xATR.getValue(0);

		const hasPrices = cClose != null && pClose != null && cHigh != null && cLow != null;
		if (!hasPrices || this.ATR == null || this.ATR <= 0) {
			this.DownPoints = 0;
			this.UpPoints = 0;
			this.RangePoints = 0;
			this.PullbackPoints = 0;
			this.DownATR = 0;
			this.UpATR = 0;
			this.RangeATR = 0;
			this.PullbackATR = 0;
			this.ShockScore = 0;
			this.WriteToStudy(studies);
			return;
		}

		const closeDelta = cClose - pClose;
		this.DownPoints = Math.max(0, -closeDelta);
		this.UpPoints = Math.max(0, closeDelta);
		this.RangePoints = Math.max(0, cHigh - cLow);
		if (this.Upward) {
			this.PullbackPoints = Math.max(0, cHigh - cClose);
		}
		else {
			this.PullbackPoints = Math.max(0, cClose - cLow);
		}

		this.DownATR = this.DownPoints / this.ATR;
		this.UpATR = this.UpPoints / this.ATR;
		this.RangeATR = this.RangePoints / this.ATR;
		this.PullbackATR = this.PullbackPoints / this.ATR;
		if (this.Upward) {
			this.ShockScore = Math.max(this.DownATR, this.PullbackATR);
		}
		else {
			this.ShockScore = Math.max(this.UpATR, this.PullbackATR);
		}

		this.WriteToStudy(studies);
	}

	WriteToStudy(studies) {
		if (!this.tag || !studies || !studies[0]) return;

		studies[0][this.Tag('ATR')] = this.ATR;
		studies[0][this.Tag('DownPoints')] = this.DownPoints;
		studies[0][this.Tag('UpPoints')] = this.UpPoints;
		studies[0][this.Tag('RangePoints')] = this.RangePoints;
		studies[0][this.Tag('PullbackPoints')] = this.PullbackPoints;
		studies[0][this.Tag('DownATR')] = this.DownATR;
		studies[0][this.Tag('UpATR')] = this.UpATR;
		studies[0][this.Tag('RangeATR')] = this.RangeATR;
		studies[0][this.Tag('PullbackATR')] = this.PullbackATR;
		studies[0][this.Tag('Score')] = this.ShockScore;
	}

	Tag(varName) {
		return Study_PriceShock.Label(this.tag, varName);
	}

	static Label(tag, varName) {
		return `${tag}_${varName}`;
	}
}

/*************************************************************************************************/
/****************************************** ADXTrend Strategy Study   ****************************/
/*************************************************************************************************/
// SADX short-position signal
// Dependencies: Study_ADX, Study_PriceShock, Study_SMASlope and global cClose.
class Study_SADX {
	// Configuration and initial state. Null/missing parameters use the defaults below.
	constructor(label, params) {
		params = params || {};

		// Output namespace and four snapshots maintained by the parent collection.
		this.tag = label;
		this.adxTag = 'Active';
		this.studyArr = [{side: 0}, {}, {}, {}];

		// Directional bias is +DI minus -DI, not ADX strength. Entry uses <, exit uses >.
		const entry = params.entry || {};
		const exit = params.exit || {};
		this.startBiasShortTrend = entry.startBiasShortTrend == null ? -0.5 : entry.startBiasShortTrend;
		this.startBiasLongTrend = entry.startBiasLongTrend == null ? -2.5 : entry.startBiasLongTrend;
		this.stopBiasShortTrend = exit.stopBiasShortTrend == null ? 1.5 : exit.stopBiasShortTrend;
		this.stopBiasLongTrend = exit.stopBiasLongTrend == null ? 0 : exit.stopBiasLongTrend;
		this.exitOnGuideCrossLongTrend = exit.exitOnGuideCrossLongTrend == null ? true : exit.exitOnGuideCrossLongTrend;
		this.trend = 0;
		this.startBias = this.startBiasLongTrend;
		this.stopBias = this.stopBiasLongTrend;
		// Require MA recovery below the upper guide band after a guide-cross exit.
		this.requireGuideExitRecovery = false;
		// Cooldown 2: exit age 0; next bar age 1 is blocked; age 2 is eligible.
		// Continuation 5: breakout age 0 through 5 inclusive; 0 disables this entry path.
		this.reEntryCooldownBars = (params.entry == null ? undefined : params.entry.reEntryCooldownBars) == null ? 1 : Math.floor((params.entry == null ? undefined : params.entry.reEntryCooldownBars));
		this.continuationEntryBars = (params.entry == null ? undefined : params.entry.continuationEntryBars) == null ? 5 : Math.floor((params.entry == null ? undefined : params.entry.continuationEntryBars));
		// Shock thresholds are multiples of ATR. A trade starts unarmed.
		this.shockRiseATR = (params.exit == null ? undefined : params.exit.shockRiseAtr) == null ? 1.15 : (params.exit == null ? undefined : params.exit.shockRiseAtr);
		this.shockArmedRiseATR = (params.exit == null ? undefined : params.exit.shockArmedRiseAtr) == null ? 0.85 : (params.exit == null ? undefined : params.exit.shockArmedRiseAtr);
		this.shockArmDownATR = (params.exit == null ? undefined : params.exit.shockArmDownAtr) == null ? 0.75 : (params.exit == null ? undefined : params.exit.shockArmDownAtr);
		this.shockRangeATR = (params.exit == null ? undefined : params.exit.shockRangeAtr) == null ? 1.8 : (params.exit == null ? undefined : params.exit.shockRangeAtr);

		// Block entry when BOTH the band is narrow AND its slope is nearly flat.
		this.chopMinGuideWidthATR = (params.entry == null ? undefined : params.entry.chopMinGuideWidthAtr) == null ? 0.80 : (params.entry == null ? undefined : params.entry.chopMinGuideWidthAtr);
		this.chopMaxGuideSlopeATR = (params.entry == null ? undefined : params.entry.chopMaxGuideSlopeAtr) == null ? 0.06 : (params.entry == null ? undefined : params.entry.chopMaxGuideSlopeAtr);

		// Current-bar inputs read from the upstream studies by ResetSwitches.
		this.adxVal = undefined;
		this.adxBias = undefined;
		this.adxSlope = undefined;
		this.priceMA = undefined;
		this.guideMA = undefined;
		this.guideLB = undefined;
		this.guideUB = undefined;
		this.shockScore = 0;
		this.shockDownATR = 0;
		this.shockUpATR = 0;
		this.shockRangeATRValue = 0;
		this.shockPullbackATR = 0;
		this.shockATR = undefined;
		// Compatibility diagnostic: stays zero; the actual chop test uses a local width.
		this.guideWidthATR = 0;
		this.isChop = false;

		// 1,000,000 means no recent exit/breakout; counters saturate at this value.
		this.maxDownATR = 0;
		this.barsSinceExit = 1000000;
		this.barsSinceGuideBreakout = 1000000;
		this.wasBeyondGuide = false;
		// Kept blank to match current C++ reporting; StopReason carries the exit label.
		this.lastExitReason = "";
		this.stopReason = "";
	}

	// 0 = flat, -1.1 = below-guide continuation, -1.2 = above-guide pullback.
	// Both negative subtypes represent one short position.
	get Side() {
		return this.studyArr[0].side == null ? 0 : this.studyArr[0].side;
	}
	set Side(val) {
		this.studyArr[0].side = val == null ? 0 : val;
	}
	// Previous completed-bar side, retained for callers; exits are reset directly in Calc.
	get pSide() {
		return this.studyArr[1].side == null ? 0 : this.studyArr[1].side;
	}

	// Restore previous state, refresh inputs, then make at most one entry OR exit decision.
	Calc(studies) {
		this.ResetSwitches(studies);

		// Missing study rows must not reuse inputs left over from an earlier call.
		if (studies[0] == null || studies[1] == null || this.adxVal == null || this.adxBias == null || this.priceMA == null
			|| this.guideMA == null || this.guideLB == null || this.guideUB == null) {
			this.writeStudies(studies);
			return;
		}

		if (this.Side === 0) {
			this.Side = this.TestStart(studies);
			// Ignore the entry bar's downward shock: arming begins on held bars.
			if (this.Side !== 0) {
				this.maxDownATR = 0;
				this.requireGuideExitRecovery = false;
			}
		}
		else {
			if (this.TestStop(studies)) {
				this.Side = 0;
				this.requireGuideExitRecovery = this.stopReason === "LONG_TREND_GUIDE_CROSS";
				// Reset immediately on the exit bar, not by detecting pSide next time.
				this.barsSinceExit = 0;
				this.maxDownATR = 0;
			}
		}
		this.writeStudies(studies);
	}

	// Save all mutable trading state first, then publish this bar's diagnostics.
	writeStudies(studies) {
		const state = this.studyArr[0];
		state.requireGuideExitRecovery = this.requireGuideExitRecovery;
		state.maxDownATR = this.maxDownATR;
		state.barsSinceExit = this.barsSinceExit;
		state.barsSinceGuideBreakout = this.barsSinceGuideBreakout;
		state.beyondGuide = this.wasBeyondGuide;
		state.stopReason = this.stopReason;
		// Tells the next bar to increment the cooldown once from this snapshot.
		state.hasPrevious = true;
		const cStudy = studies[0];
		if (cStudy == null) return;

		cStudy[this.Tag('Side')] = this.Side;
		cStudy[this.Tag('PriceMA')] = this.priceMA;
		cStudy[this.Tag('GuideMA')] = this.guideMA;
		cStudy[this.Tag('GuideUB')] = this.guideUB;
		cStudy[this.Tag('GuideLB')] = this.guideLB;
		cStudy[this.Tag('ADX')] = this.adxVal;
		cStudy[this.Tag('ADXBias')] = this.adxBias;
		cStudy[this.Tag('ADXSlope')] = this.adxSlope;
		cStudy[this.Tag('ADXTrigger')] = this.startBias;
		cStudy[this.Tag('StopBias')] = this.stopBias;
		cStudy[this.Tag('MarketTrend')] = this.trend;
		// Arming/cooldown values are post-decision: both are zero on an exit bar.
		cStudy[this.Tag('MaxDownATR')] = this.maxDownATR;
		cStudy[this.Tag('BarsSinceExit')] = this.barsSinceExit;
		cStudy[this.Tag('LastExitReason')] = this.lastExitReason;
		cStudy[this.Tag('ShockScore')] = this.shockScore;
		cStudy[this.Tag('ShockDownATR')] = this.shockDownATR;
		cStudy[this.Tag('ShockUpATR')] = this.shockUpATR;
		cStudy[this.Tag('ShockPullbackATR')] = this.shockPullbackATR;
		cStudy[this.Tag('ShockRangeATR')] = this.shockRangeATRValue;
		cStudy[this.Tag('GuideWidthATR')] = this.guideWidthATR;
		cStudy[this.Tag('Chop')] = this.isChop ? 1 : 0;
		cStudy[this.Tag('StopReason')] = this.stopReason;
	}

	// Recompute from the preceding snapshot. Do not accumulate intra-bar updates.
	ResetSwitches(studies) {
		const cStudy = studies[0];
		const pStudy = studies[1];


		// StudyCollection restores studyArr[0] from the preceding bar before every Calc.
		// Restore all trading state too, so repeated current-bar updates recompute it.
		// Clear current inputs before checking row availability; never reuse a stale trend.
		this.trend = 0;
		this.startBias = this.startBiasLongTrend;
		this.stopBias = this.stopBiasLongTrend;
		this.adxVal = this.adxBias = this.priceMA = this.guideMA = this.guideLB = this.guideUB = undefined;
		const state = this.studyArr[0];
		this.requireGuideExitRecovery = state.requireGuideExitRecovery === true;
		this.maxDownATR = state.maxDownATR == null ? 0 : state.maxDownATR;
		this.barsSinceExit = state.barsSinceExit == null ? 1000000 : state.barsSinceExit;
		this.barsSinceGuideBreakout = state.barsSinceGuideBreakout == null ? 1000000 : state.barsSinceGuideBreakout;
		this.wasBeyondGuide = state.beyondGuide === true;
		this.stopReason = state.stopReason == null ? "" : state.stopReason;
		if (state.hasPrevious && this.barsSinceExit < 1000000) this.barsSinceExit++;

		// Restore state even during warmup; Calc suppresses decisions without both rows.
		if (cStudy == null || pStudy == null) return;


		// Read directional indicators and price/guide moving averages.
		this.adxVal = cStudy[Study_ADX.Label(this.adxTag, 'ADX')];
		const pdiVal = cStudy[Study_ADX.Label(this.adxTag, 'PDI')];
		const ndiVal = cStudy[Study_ADX.Label(this.adxTag, 'NDI')];
		this.adxBias = pdiVal == null || ndiVal == null ? undefined : pdiVal - ndiVal;

		this.priceMA = cStudy.MAPrice;
		this.guideMA = cStudy.MIDGuide;
		this.guideLB = cStudy.LBGuide;
		this.guideUB = cStudy.UBGuide;
		this.adxSlope = cStudy[`${this.adxTag}_ADX_SLOPE`];
		this.trend = cStudy.MarketTrend_READY === 1 && (cStudy.MarketTrend === 1 || cStudy.MarketTrend === -1)
			? cStudy.MarketTrend : 0;
		const bearishTrend = this.trend === -1;
		this.startBias = bearishTrend ? this.startBiasShortTrend : this.startBiasLongTrend;
		this.stopBias = bearishTrend ? this.stopBiasShortTrend : this.stopBiasLongTrend;

		// Missing shock components default to zero, matching the supplied EFS behavior.
		this.shockScore = cStudy[Study_PriceShock.Label('Shock', 'Score')] ?? 0;
		this.shockDownATR = cStudy[Study_PriceShock.Label('Shock', 'DownATR')] ?? 0;
		this.shockUpATR = cStudy[Study_PriceShock.Label('Shock', 'UpATR')] ?? 0;
		this.shockRangeATRValue = cStudy[Study_PriceShock.Label('Shock', 'RangeATR')] ?? 0;
		this.shockPullbackATR = cStudy[Study_PriceShock.Label('Shock', 'PullbackATR')] ?? 0;
		this.shockATR = cStudy[Study_PriceShock.Label('Shock', 'ATR')];

		// Normalize guide width and absolute slope by ATR for the chop filter.
		// Missing inputs use zero ratios and may classify as chop; preserved for parity.
		const guideSlopePerBar = cStudy[Study_SMASlope.Label('SLGuide', 'MASlopeValue')];
		const guideWidth = this.guideUB != null && this.guideLB != null ? Math.max(0, this.guideUB - this.guideLB) : 0;
		const hasChopInputs = this.shockATR != null && this.shockATR > 0 && guideWidth > 0 && guideSlopePerBar != null;

		// Chop means the guide band is both narrow and nearly flat
		const guideWidthATR = hasChopInputs ? guideWidth / this.shockATR : 0;
		const guideSlopeATR = hasChopInputs ? Math.abs(guideSlopePerBar) / this.shockATR : 0;
		this.isChop =  this.chopMaxGuideSlopeATR > 0 && guideSlopeATR <= this.chopMaxGuideSlopeATR
			&& this.chopMinGuideWidthATR > 0 && guideWidthATR <= this.chopMinGuideWidthATR;

		// Track the largest single-bar downward shock within this trade (not cumulative gain).
		// A held bar may both reach the arming threshold and trigger an armed exit.
		if (this.Side !== 0) {
			this.stopReason = "";
			if (this.shockDownATR > this.maxDownATR) {
				this.maxDownATR = this.shockDownATR;
			}
		}

		// Track the guide breakout on every bar, including while in a trade.
		// BOTH the MA and close must be at/below the guide. Any break resets the window.
		const beyond = this.priceMA <= this.guideMA && cClose <= this.guideMA;
		if (!beyond) this.barsSinceGuideBreakout = 1000000;
		else if (!this.wasBeyondGuide) this.barsSinceGuideBreakout = 0;
		else if (this.barsSinceGuideBreakout < 1000000) this.barsSinceGuideBreakout++;
		this.wasBeyondGuide = beyond;
	}

	// Flat-position entry rules. Cooldown, chop, bias and recovery gates apply to both paths.
	TestStart(studies) {
		const cStudy = studies[0];
		const pStudy = studies[1];
		const isReEntryCoolDownStillActive =
			this.reEntryCooldownBars > 0 && this.barsSinceExit < this.reEntryCooldownBars;

		if (isReEntryCoolDownStillActive || cStudy == null || pStudy == null) {
			return 0.0;
		}

		// Check if BIAS value is not deteriorating, get previous BIAS Value first
		const pdiVal = pStudy[Study_ADX.Label(this.adxTag, 'PDI')];
		const ndiVal = pStudy[Study_ADX.Label(this.adxTag, 'NDI')];
		const pAdxBias = pdiVal == null || ndiVal == null ? undefined : pdiVal - ndiVal;
		const biasNotDeteriorating = pAdxBias == null || this.adxBias <= pAdxBias;

		// No shock/slope gate on continuation: matches corrected C++/ADXBase.
		const continuationBelowGuide = this.priceMA <= this.guideMA && cClose <= this.guideMA;
		const continuationWindow = this.continuationEntryBars > 0
			&& this.barsSinceGuideBreakout <= this.continuationEntryBars;
		const pullbackEntry =  this.trend === 1 && this.priceMA > this.guideMA;
		const trendReEntry = continuationBelowGuide && continuationWindow;

		// start only when
		// - the band is not simultaneously narrow AND flat (!this.isChop)
		// - and the price is falling (cStudy.MAPrice <= pStudy.MAPrice)
		// - and the ADX bias is below the start threshold
		// - and either a above-guide pullback or an in-window below-guide continuation is present
		// After a guide-cross exit, require the price MA below the upper guide band.
		const guideExitRecovery = !this.requireGuideExitRecovery || this.priceMA < this.guideUB;
		const shouldStart = !this.isChop
			&& guideExitRecovery
			&& biasNotDeteriorating
			&& this.adxBias < this.startBias
			&& cStudy.MAPrice <= pStudy.MAPrice
			&& (
				pullbackEntry
				|| trendReEntry
			)
		if (shouldStart) {
			return trendReEntry ? -1.1 : pullbackEntry ? -1.2 : 0.0;
		}
		return 0.0;
	}

	// Exit priority: bias, unconditional shock, armed shock, adverse wide-range bar, bullish guide cross.
	// First match wins. Threshold equality triggers shock exits, but not the bias exit.
	TestStop(studies) {
		// Arm after a favorable downward shock; exit on adverse downward moves.
		const shockArmed = this.maxDownATR >= this.shockArmDownATR;
		const rapidRise = this.shockScore >= this.shockRiseATR;
		const armedRise = shockArmed && this.shockScore >= this.shockArmedRiseATR;
		const shockRangeRise = this.shockRangeATRValue >= this.shockRangeATR && this.shockUpATR > 0;

		if (this.adxBias > this.stopBias) {
			this.stopReason = "ADX_BIAS";
			return true;
		}
		if (rapidRise) {
			this.stopReason = "SHOCK_RISE";
			return true;
		}
		if (armedRise) {
			this.stopReason = "ARMED_RISE";
			return true;
		}
		if (shockRangeRise) {
			this.stopReason = "SHOCK_RANGE";
			return true;
		}
		// Chart-timeframe cross, enabled only for a confirmed bullish regime.
		// Existing bias/shock exits keep priority. Being above alone is not a cross.
		const pStudy = studies[1];
		const crossedAboveGuide = this.exitOnGuideCrossLongTrend && this.trend === 1 &&
			pStudy != null && Number.isFinite(pLow) && Number.isFinite(cLow) &&
			Number.isFinite(pStudy.UBGuide) && Number.isFinite(this.guideUB) &&
			pLow <= pStudy.UBGuide && cLow > this.guideUB;
		if (crossedAboveGuide) {
			this.stopReason = "LONG_TREND_GUIDE_CROSS";
			return true;
		}
		return false;
	}

	// Preserve EFS column names, e.g. STrend_SADX_Side; C++ uses SADX_SIDE.
	Tag(varName) {
		return Study_SADX.Label(this.tag, varName);
	}
	static Label(tag, varName) {
		return `${tag}_SADX_${varName}`;
	}
}

/*************************************************************************************************/
/***************************************** SMA SLope Strategy Study   ****************************/
/*************************************************************************************************/
class Study_SMASlope {
	constructor(maLength, lookbackBars, flatPoints, label = null, source = null) {
		this.tag = label;
		this.source = source;
		if (!Number.isSafeInteger(maLength) || maLength < 1 || !Number.isSafeInteger(lookbackBars) || lookbackBars < 1) {
			throw new Error("SMA lengths must be positive integers");
		}
		if (!Number.isFinite(flatPoints) || flatPoints < 0) throw new Error("Invalid SMA flat threshold");
		if (source && source.capacity < maLength + lookbackBars) throw new Error("SMA source capacity too small");
		this.xMA = source ? source.SMA(maLength) : sma(maLength);

		this.lookbackBars = lookbackBars;
		this.flatPoints = flatPoints;

		if (!source) this.studyArr = [{
			MASlope: 0
		}, {}];
	}

	Calc(studies) {
		const barState = this.source ? null : getBarState();

		if (!this.source && barState === BARSTATE_NEWBAR) {
			this.studyArr[1].MASlope = this.studyArr[0].MASlope;
		}

		const cStudy = studies[0];

		const maNow = this.xMA.getValue(0);
		const maPast = this.xMA.getValue(-this.lookbackBars);

		if (this.source) {
			cStudy[this.Tag("READY")] = maNow != null && maPast != null ? 1 : 0;
			cStudy[this.Tag("BARS")] = this.source.count;
			cStudy[this.Tag("MA")] = maNow;
			cStudy[this.Tag("MASlopeValue")] = null;
			cStudy[this.Tag("MASlope")] = 0;
		}
		if (maNow == null || maPast == null) {
			return;
		}

		const slope = maNow - maPast;
		const slopePerBar = slope / this.lookbackBars;

		let slopeFlag = 0;

		if (Math.abs(slopePerBar) <= this.flatPoints) {
			slopeFlag = 0;
		}
		else if (slopePerBar > 0) {
			slopeFlag = 1;
		}
		else {
			slopeFlag = -1;
		}

		if (!this.source) this.studyArr[0].MASlope = slopeFlag;

		cStudy[`${this.Tag('MASlope')}`] = slopeFlag;
		cStudy[`${this.Tag('MA')}`] = maNow;
		cStudy[`${this.Tag('MASlopeValue')}`] = slopePerBar;
	}

	Tag(varName) {
		return Study_SMASlope.Label(this.tag, varName);
	}

	static Label(tag, varName) {
		return `${tag}_${varName}`;
	}
}



/***********************************************************************************************************
 ************************************  ORDER PROCESSING ENGINE AND STRATEGIES ******************************
 ***********************************************************************************************************/
// BASE Strategy Class

class Strategy {
	constructor(studyCollection, qty, qtyPct, aum, multiplier) {
		this.label = "";
		this.qty = qty;
		this.qtyPct = qtyPct;
		this.aum = aum;
		this.multiplier = multiplier;

		this.studyCollection = studyCollection;
		this.periods = this.studyCollection ? this.studyCollection.periods : null;

		// main Side for the strategy. 0 means no signal, != 0 means either long or short depending on the sign
		this.strategyVars = [{side: 0, stopPrice: 0}, {side: 0, stopPrice: 0}];

		// counter of number of bars this strategy was activeStrategies
		this.sideDefsList = [];
		this.sideDefsMap = {};

		this.barState = getBarState();
		this.vars = [];
		this.lastTrade = null;

		this.canReinvestAUM = false;
	}

	get cSide() {
		return this.strategyVars[0].side == null ? 0 : this.strategyVars[0].side;
	}

	set cSide(val) {
		this.strategyVars[0].side = val;
	}

	get pSide() {
		return this.strategyVars[1].side == null ? 0 : this.strategyVars[1].side;
	}

	set pSide(val) {
		this.strategyVars[1].side = val;
	}

	get cStopPrice() {
		return this.strategyVars[0].stopPrice == null ? 0 : this.strategyVars[0].stopPrice;
	}

	set cStopPrice(val) {
		this.strategyVars[0].stopPrice = val;
	}

	get pStopPrice() {
		return this.strategyVars[1].stopPrice == null ? 0 : this.strategyVars[1].stopPrice;
	}

	set pStopPrice(val) {
		this.strategyVars[1].stopPrice = val;
	}

	InitSideDefs(sideDefs) {
		// add initializations of stats and create a Map for easy access of the side
		this.sideDefsMap = {};
		this.sideDefsList = [];
		sideDefs.forEach(sideDef => {
			// add stats
			sideDef['barCounter'] = 0;
			sideDef['barFreq'] = 0;
			sideDef['periods'] = [];
			// add financial info
			sideDef['openPL'] = 0;
			sideDef['closePL'] = 0;
			sideDef['qty'] = 0;
			sideDef['tradeVal'] = 0;
			//
			this.sideDefsMap[`${sideDef.side}`] = sideDef;
			this.sideDefsList.push(sideDef);
		});
	}
	PreOperations(trackData) {
		this.lastTrade = null;
	}

	Calc(trade, trackData) {
		this.barState = getBarState();
		if (this.barState === BARSTATE_NEWBAR) {
			this.strategyVars.pop();
			this.strategyVars.unshift({side: 0, stopPrice: 0});
			this.vars.pop();
			this.vars.unshift({});
		}
		this.vars[0] = JSON.parse(JSON.stringify(this.vars[1]));	// deep copy
		this.strategyVars[0].side = this.strategyVars[1].side;
		this.strategyVars[0].stopPrice = this.strategyVars[1].stopPrice;
		this.ResetSwitches(trackData);
		if (this.cSide === 0) {
			this.CheckStartSignal(trackData);
		} else {
			this.CheckEndSignal(trade, trackData);
		}
		this.PostOp(trackData);
	}




	FinCalc(finData, isNewBar) {
		// 1- update all stats in all sides
		if (finData == null) {
			finData = {side: undefined, qtyDeal: 0, valueDeal: 0, fillPrice: 0, orderTag: ""}
		}
		this.sideDefsList.forEach(barStatObj => {
			if (barStatObj.side !== 'ALL') {
				this.UpdateSideCumulativeValues(barStatObj, finData.side, finData.qtyDeal, finData.valueDeal, finData.orderTag, isNewBar);
			}
		});
		// calc ALL
		const sideDef = {barCounter: 0, barFreq: 0, qty: 0, openPL: 0, closePL: 0};
		let sideDefAll = null;
		this.sideDefsList.forEach(barStatObj => {
			if (barStatObj.side !== 'ALL') {
				sideDef.barCounter += barStatObj.barCounter;
				sideDef.barFreq += barStatObj.barFreq;
				sideDef.openPL += barStatObj.openPL;
				sideDef.closePL += barStatObj.closePL;
				sideDef.qty += barStatObj.qty;
			} else {
				sideDefAll = barStatObj;
			}
		});
		if (sideDefAll) {
			sideDefAll.barCounter = sideDef.barCounter;
			sideDefAll.barFreq = sideDef.barFreq;
			sideDefAll.openPL = sideDef.openPL;
			sideDefAll.closePL = sideDef.closePL;
			sideDefAll.qty = sideDef.qty;
		}

		// this needs to be revisited for DrawBars logic
		if (isNewBar && this.cSide !== 0) {
			const barStatObj = this.sideDefsMap[`${this.cSide}`];
			if (barStatObj) {
				const openPrice = (finData.orderTag && finData.fillPrice && finData.orderTag === 'OPEN') ? finData.fillPrice : 0;
				const closePrice = (finData.orderTag && finData.fillPrice && finData.orderTag === 'CLOSE') ? finData.fillPrice : 0;
				barStatObj.barCounter++;
				if (this.pSide === 0) {
					barStatObj.barFreq++;
					barStatObj.periods.push({
						startBar: getCurrentBarIndex(),
						endBar: getCurrentBarIndex(),
						openPrice: openPrice,
						closePrice: closePrice,
						high: high(0),
						low: low(0)
					});
				} else {
					barStatObj.periods[barStatObj.periods.length - 1].endBar = getCurrentBarIndex();
					if (openPrice > 0) {
						barStatObj.periods[barStatObj.periods.length - 1].openPrice = openPrice;
					}
					if (closePrice > 0) {
						barStatObj.periods[barStatObj.periods.length - 1].closePrice = closePrice;
					}
				}
			}
		}
	}

	UpdateSideCumulativeValues(barStatObj, side, iQty, iTradeVal, orderTag, isNewBar) {
		const isClose = orderTag === 'CLOSE';
		const isThisSide = side && `${side}` === barStatObj.side;
		const qty = iQty != null && isThisSide ? iQty : 0;
		const tradeVal = iTradeVal != null && isThisSide ? iTradeVal : 0;

		// if (!isThisSide) {
		// return;
		// }
		const cClose = isNewBar ? close(-1) : close(0);
		if (isNewBar) {
			barStatObj.qty += qty;
			barStatObj.tradeVal += tradeVal;
			//barStatObj.closePL = barStatObj.qty === 0 && isSideChanged ? barStatObj.tradeVal : barStatObj.closePL;
			barStatObj.openPL = barStatObj.qty === 0 ? 0 : (cClose * this.multiplier * barStatObj.qty) + (barStatObj.tradeVal);
			barStatObj.closePL += isClose ? barStatObj.tradeVal : 0;
			barStatObj.tradeVal = isClose ? 0 : barStatObj.tradeVal;
		}
	}

	CheckStartSignal(trackData) {
		if (this.cSide === 0) {
			this.cSide = this.CanOpen(trackData);
			this.cSide = this.cSide == null ? 0 : this.cSide;
			if (this.cSide !== 0) {
				this.cStopPrice = 0;
			}
		}
		return this.cSide;
	}

	CheckEndSignal(trade, trackData) {
		this.cStopPrice = 0;
		if (this.cSide !== 0) {
			this.cStopPrice = this.CanClose(trade, trackData);
			this.cStopPrice = this.cStopPrice == null ? 0 : this.cStopPrice;
			if (this.cStopPrice > 0) {
				this.cSide = 0;
			}
		}
		return this.cStopPrice;
	}

	OpenTrade(trackData) {
		if (this.cSide !== 0) {
			// we are looking at the prices from previous bar since the signal (Side != 0) occurred in the previous bar
			const cHigh = high(-1);
			const cLow = low(-1);
			const cClose = close(-1);
			const cHLC = (cHigh + cLow + cClose) / 3.0;

			const cTrackData = trackData[1];

			let dealQty = this.qty > 0 ? this.qty : 0;
			//const maxQty = Math.ceil(this.aum / this.multiplier / cHLC);
			const cNnet = cTrackData.cumulativeData.dealClosePL + cTrackData.cumulativeData.dealOpenPL + cTrackData.cumulativeData.dealCommission;
			const aum = this.canReinvestAUM ? this.aum + cNnet : this.aum;

			if (dealQty === 0 && this.qtyPct > 0 && this.qtyPct <= 1.0) {
				//dealQty = Math.ceil(((this.aum /*+ cNnet*/) * this.qtyPct) / this.multiplier / cHLC);
				dealQty = Math.ceil((aum * this.qtyPct) / this.multiplier / cHLC);
			}

			if (dealQty !== 0) {
				const posSign = this.cSide > 0 ? 1 : -1;
				return {
					id: -1,
					rawTime: cTrackData.rawTime,
					strategy: this.label,
					side: this.cSide,
					orderTag: "OPEN",
					orderType: "MARKET",
					qty: posSign * dealQty,
					price: 0,
					tradeStatus: "NEW",
					fillQty: 0,
					fillPrice: 0,
					lastRawTime: cTrackData.rawTime,
				};
			}
		}

		return null;
	}

	LimitPrice(trade, _trackData) {
		// if Close price already determined, just update price
		if (trade && trade.price && trade.price > 0) {
			return close(-1);
		}
		return this.cStopPrice;
	}

	OnFilled(trade, trackData) {
		this.lastTrade = JSON.parse(JSON.stringify(trade));
		if (trade.orderTag === "OPEN") {
			return this.OnFilledOpen(trade, trackData);
		} else if (trade.orderTag === "CLOSE") {
			return this.OnFilledClose(trade, trackData);
		}
		return null;
	}

	OnFilledOpen(trade, trackData) {
		const newTrade = {...trade};
		newTrade.id = -1;
		newTrade.rawTime = trackData[0].rawTime;
		newTrade.orderTag = "CLOSE";
		newTrade.orderType = "LIMIT";
		newTrade.qty = -trade.qty;
		newTrade.price = 0;
		newTrade.tradeStatus = "NEW";
		newTrade.fillQty = 0;
		newTrade.fillPrice = 0;
		newTrade.lastRawTime = trackData[0].rawTime;
		return newTrade;
	}

	OnFilledClose(trade, trackData) {
		this.cSide = 0;
		return null;
	}

	// Override GetMonitorVar
	// ---------
	GetMonitorVar() {
		return {};
	}

	// OVERRIDE ResetSwitches
	// --------
	ResetSwitches(_trackData) {
		// to be implemented by the derived class
	}

	// OVERRIDE CanOpen
	// --------
	CanOpen(_trackData) {
		return 0;
	}

	// OVERRIDE CanClose
	// --------
	CanClose(_trade, _trackData) {
		return 0;
	}

	// OVERRIDE PostOp
	// --------
	PostOp(_trackData) {
		// to be implemented by the derived class
	}
}

// BASE Trade Engine Class
class TradeEngine {
	constructor(aum, multiplier, commission, dataFilename = "", compactMode = true, canReinvestAUM = false) {
		this.canReinvestAUM = canReinvestAUM;  // future use... this will allow AUM to be reinvested in the strategy
		this.compactMode = compactMode;
		this.activeTrades = [];
		this.completedTrades = [];
		this.strategies = [];
		this.dataFilename = dataFilename;
		this.cumulativeData = {
			dealQty : 0,
			dealVal : 0,
			dealCommission : 0,
			dealClosePL : 0,
			dealOpenPL : 0,
			prevDealQty : 0
		};

		this.awayAdj = 0;
		this.aum = aum;
		this.multiplier = multiplier;
		this.commission = commission;
		this.trackData = [{}, {}];
		this.tradeId = 1;
		this.NAV = 100;
		this.NAVMax = 100;
		// this.NAVDrawDown = (this.NAV / this.NAVMax - 1) * 100 ;
		this.NAVDrawDown = (this.NAV / this.NAVMax) ;
		this.MaxDrawDown = 0;
		this.canResetNAV_Trade = false;

		this.NAV_Trade = this.NAV;
		this.NAV_TradeMax = 100;
		this.NAV_TradeDrawDown = 0;
		this.NAV_TradeMaxDrawDown = 0;

		this.net = 0;
		this.totalBars = 0;

		this.fileHandle = null
		this.WriteHeader();

		this.started = false;

		// data output params
		this.openTrade = null;
		this.lastCloseNet = null;
	}

	AddStrategy(strategyParam, studyCol) {
		if (strategyParam == null) return;

		// strategyParam example:  {name: "S100dot2", qty: 3, qtyPct: 0, enable: false}
		const enabled = strategyParam.enable == null ? true : strategyParam.enable;
		const qty = strategyParam.qty;
		const qtyPct = strategyParam.qtyPct;
		const arg1 = typeof strategyParam.arg1 === 'string' ? `'${strategyParam.arg1}'`
			: typeof strategyParam.arg1 === 'number' ? `${strategyParam.arg1}`
				: strategyParam.arg1;
		const arg2 = typeof strategyParam.arg2 === 'string' ? `'${strategyParam.arg2}'`
			: typeof strategyParam.arg2 === 'number' ? `${strategyParam.arg2}`
				: strategyParam.arg2;

		if (enabled) {
			// Create a new instance of the strategy that is Strategy[name] dynamically
			const execStr = `new Strategy${strategyParam.name}(studyCol, ${qty}, ${qtyPct}, ${this.aum}, ${this.multiplier}, ${arg1}, ${arg2})`;
			debugPrint(execStr + '\n');
			const strategy = eval(execStr);
			if (strategy) {
				strategy.canReinvestAUM = this.canReinvestAUM;
				debugPrint(`Strategy ${strategyParam.name} added\n`);
				this.strategies.push(strategy);
			}
		}
	}

	get IsStarted() {
		return this.started;
	}

	get IsCompactMode() {
		return this.compactMode;
	}

	ProcessOrder() {
		this.started = true;
		const barState = getBarState();

		this.strategies.forEach(strategy => {
			// PreOps
			strategy.PreOperations(this.trackData);
		});

		if (barState === BARSTATE_NEWBAR) {
			this.totalBars++;
			this.trackData.pop();
			this.trackData.unshift({
				rawTime: rawtime(0)
				, qtyDeal: 0
				, valueDeal: 0
				, commissionDeal: 0
				, strategyFin: {}
				, cumulativeData: this.cumulativeData
			});

			if (!this.trackData[0].cumulativeData || !this.trackData[1].cumulativeData) {
				return;   // require two bars at least
			}
			// Handle any outstanding operation from previous bar before start
			// of new bar
			this.OpenTrades();
			this.HandleActiveTrades();
			this.UpdateActiveTrades();
			this.UpdateCumulativeValues(this.trackData[0].qtyDeal, this.trackData[0].valueDeal, this.trackData[0].commissionDeal);
			this.net = this.cumulativeData.dealClosePL + this.cumulativeData.dealOpenPL + this.cumulativeData.dealCommission;
			this.NAV = (this.aum + this.net) * 100.0 / this.aum;
			this.NAVMax = this.NAV > this.NAVMax ? this.NAV : this.NAVMax;
			// this.NAVDrawDown = (this.NAV / this.NAVMax - 1) * 100 ;
			// this.MaxDrawDown = this.NAVDrawDown < this.MaxDrawDown ? this.NAVDrawDown : this.MaxDrawDown;
			this.NAVDrawDown = this.canReinvestAUM ? (this.NAV / this.NAVMax - 1) * 100 : (this.NAV - this.NAVMax);
			this.MaxDrawDown = this.NAVDrawDown < this.MaxDrawDown ? this.NAVDrawDown : this.MaxDrawDown;
			if (this.canResetNAV_Trade) {
				this.NAV_Trade = this.NAV;
				this.NAV_TradeMax = this.NAV_Trade > this.NAV_TradeMax ? this.NAV_Trade : this.NAV_TradeMax;
				this.NAV_TradeDrawDown = this.canReinvestAUM ? (this.NAV_Trade / this.NAV_TradeMax - 1) * 100 : (this.NAV_Trade - this.NAV_TradeMax);
				this.NAV_TradeMaxDrawDown = this.NAV_TradeDrawDown < this.NAV_TradeMaxDrawDown ? this.NAV_TradeDrawDown : this.NAV_TradeMaxDrawDown;
				this.canResetNAV_Trade = false;
			}

			this.strategies.forEach(strategy => strategy.FinCalc(this.trackData[0].strategyFin[strategy.label], true));  // touch all strategies

			this.DumpData();
		}
		else {
			this.UpdateCumulativeValuesLive();
		}
		this.strategies.forEach(strategy => {
			// find the trade for this strategy from this.activeTrades just return the first trade
			const trade = this.activeTrades.find(t => t.strategy === strategy.label && t.orderTag === "CLOSE");
			strategy.Calc(trade, this.trackData);
		});  // touch all strategies
	}

	OpenTrades() {
		const activeStrategies = this.CompileActiveStrategies();
		this.strategies.forEach(strategy =>
		{
			const hasOrder = activeStrategies.find(s => s === strategy.label);
			if (!hasOrder)
			{
				const newOrder = strategy.OpenTrade(this.trackData);
				if (newOrder != null)
				{
					newOrder.id = this.tradeId++;
					this.activeTrades.push(newOrder);
					activeStrategies.push(newOrder.strategy);
				}
			}
		});
	}

	HandleActiveTrades() {
		const cClose = close(-1);

		for (let ndx = 0; ndx < this.activeTrades.length; ndx++)
		{
			const trade = this.activeTrades[ndx];
			const strategy = this.FindStrategy(trade.strategy);

			if (!strategy) {
				continue;
			}

			// update order price
			// -----------------------
			if (trade.tradeStatus === "NEW")
			{
				if (trade.orderType === "LIMIT" || trade.orderType === "STOP")
				{
					const oldPrice = trade.price;
					let price = strategy.LimitPrice(trade, this.trackData);
					price = price === null || price === 0 ? null : price;
					if (price != null && oldPrice !== price)
					{
						trade.price = price;
					}
				}
				else if (trade.orderType === "MARKET")
				{
					const oldPrice = trade.price;
					let price = trade.price === 0 ? null : trade.price;
					// follow market - adjust prices
					if (trade.qty < 0)  // short
					{
						const lowerPrice = cClose + this.awayAdj;
						price = price == null || price > lowerPrice ? lowerPrice : price;
					}
					else  // long
					{
						const upperPrice = cClose - this.awayAdj;
						price = price == null || price < upperPrice ? upperPrice : price;
					}
					if (price != null && oldPrice !== price)
					{
						trade.price = price;
					}
				}
			}
		}
	}

	UpdateActiveTrades() {
		const cLow = low(-1); // -1 means execuation immediatly on close(-1), 0 means execuationthe low(0) must be Below Close(-1) for long
		const cHigh = high(-1);

		// Go through the completedTrades and update the TradeOrderRS records
		const tmpCompletedTrades = [];
		this.activeTrades.forEach(trade =>
		{
			if (trade.price != null && trade.price > 0)
			{
				// check if trade is filled
				if ((trade.orderType === "STOP" && trade.qty < 0 && trade.price >= cLow)
					|| (trade.orderType !== "STOP" && trade.qty < 0 && trade.price <= cHigh)
					|| (trade.orderType !== "STOP" && trade.qty > 0 && trade.price >= cLow)
					|| (trade.orderType === "STOP" && trade.qty > 0 && trade.price <= cHigh))
				{
					trade.fillPrice = trade.price;
					trade.fillQty = trade.qty;
					trade.tradeStatus = "FILLED";
					trade.lastRawTime = this.trackData[0].rawTime;

					const tradeVal = -1.0 * trade.fillPrice * trade.qty * this.multiplier;
					this.trackData[0].qtyDeal += trade.qty;
					this.trackData[0].valueDeal += tradeVal;
					this.trackData[0].commissionDeal += -Math.abs(trade.qty * this.commission);
					this.trackData[0].strategyFin[trade.strategy] = {
						qtyDeal: trade.qty,
						valueDeal: tradeVal,
						fillPrice: trade.fillPrice,
						orderTag: trade.orderTag,
						side: trade.side
					}
					if (trade.orderTag === "CLOSE") {
						this.canResetNAV_Trade = true;
					}
					tmpCompletedTrades.push(trade);
				}
			}
		});
		tmpCompletedTrades.forEach(trade =>
		{
			const strategy = this.FindStrategy(trade.strategy);
			if (strategy != null)
			{
				const newOrder = strategy.OnFilled(trade, this.trackData);
				if (newOrder != null)
				{
					newOrder.id = this.tradeId++;
					this.activeTrades.push(newOrder);
				}
			}
			this.activeTrades = this.activeTrades.filter(t => t.id !== trade.id);
		});
		if (this.dataFilename !== "" && // there is no point of keeping completed trades if there is no need to create a data dump
			tmpCompletedTrades.length > 0) {
			this.completedTrades.push(...tmpCompletedTrades);
		}
	}

	CompileActiveStrategies() {
		const activeStrategies = [];
		this.activeTrades.forEach(trade =>
		{
			if (!activeStrategies.find(s => s === trade.strategy))
			{
				activeStrategies.push(trade.strategy);
			}
		});
		return activeStrategies;
	}

	FindStrategy(label) {
		return this.strategies.find(strategy => strategy.label === label);
	}

	UpdateCumulativeValues(qty, tradeVal, commission) {
		this.cumulativeData.dealQty += qty;
		this.cumulativeData.dealVal += tradeVal;
		this.cumulativeData.dealCommission += commission;
		this.cumulativeData.dealClosePL = this.cumulativeData.dealQty === 0 && this.cumulativeData.prevDealQty !== 0 ? this.cumulativeData.dealVal : this.cumulativeData.dealClosePL;
		this.cumulativeData.dealOpenPL = this.cumulativeData.dealQty === 0 ? 0 : (close(-1) * this.multiplier * this.cumulativeData.dealQty) + (this.cumulativeData.dealVal - this.cumulativeData.dealClosePL);
		this.cumulativeData.prevDealQty = this.cumulativeData.dealQty;
	}
	UpdateCumulativeValuesLive() {
		this.cumulativeData.dealOpenPL = this.cumulativeData.dealQty === 0 ? 0 : (close(0) * this.multiplier * this.cumulativeData.dealQty) + (this.cumulativeData.dealVal - this.cumulativeData.dealClosePL);
		this.net = this.cumulativeData.dealClosePL + this.cumulativeData.dealOpenPL + this.cumulativeData.dealCommission;
		this.NAV = (this.aum + this.net) * 100.0 / this.aum;
		this.NAVMax = this.NAV > this.NAVMax ? this.NAV : this.NAVMax;
		// this.NAVDrawDown = (this.NAV / this.NAVMax - 1) * 100 ;
		// this.MaxDrawDown = this.NAVDrawDown < this.MaxDrawDown ? this.NAVDrawDown : this.MaxDrawDown;
		this.NAVDrawDown = this.canReinvestAUM ? (this.NAV / this.NAVMax - 1) * 100 : (this.NAV - this.NAVMax);
		this.MaxDrawDown = this.NAVDrawDown < this.MaxDrawDown ? this.NAVDrawDown : this.MaxDrawDown;

	}

	GetAllStrategyParams() {
		let paramMap = {};
		this.strategies.forEach(strategy => paramMap = Object.assign({}, paramMap, strategy.GetMonitorVar()));
		return paramMap;
	}

	GetAllStrategySides() {
		let sideMap = {};
		this.strategies.forEach(strategy => {
			let statColor = strategy.sideDefsList[`${strategy.cSide}`] ? strategy.sideDefsList[`${strategy.cSide}`].color : Color.white;
			statColor = statColor ? statColor : Color.white;
			sideMap[`${strategy.label}_Side`] = {value: strategy.cSide, color: statColor, isText: true};
		});
		return sideMap;
	}

	GetAllStrategyStats() {
		const statMap = {TotalBars: {value: this.totalBars, isText: true}};
		const totalBars = this.totalBars === 0 ? 1 : this.totalBars;
		this.strategies.forEach(strategy => {
			strategy.sideDefsList.forEach(sideDef => {
				const enabled = sideDef.enable != null ? sideDef.enable : true;
				if (enabled) {
					let sideTag = `_${sideDef.side}`;
					if (sideDef.side === 'ALL') {
						sideTag = '';
					}
					if (this.IsCompactMode) {
						statMap[`${strategy.label}${sideTag}_bar_Frq`] = {value: `${sideDef.barCounter}_${sideDef.barFreq}`, color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_ClosePL`] = {value: sideDef.closePL.toFixed(2), color: sideDef.color, isText: true};
					}
					else {
						statMap[`${strategy.label}${sideTag}_Bars`] = {value: sideDef.barCounter, color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_Perc`] = {value: sideDef.barCounter / totalBars, color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_Freq`] = {value: sideDef.barFreq, color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_Qty`] = {value: sideDef.qty, color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_OpenPL`] = {value: sideDef.openPL.toFixed(2), color: sideDef.color, isText: true};
						statMap[`${strategy.label}${sideTag}_ClosePL`] = {value: sideDef.closePL.toFixed(2), color: sideDef.color, isText: true};
					}
				}
				else if (!enabled && sideDef.side === 'ALL') {
					statMap[`${strategy.label}_Bars`] = {value: sideDef.barCounter, color: sideDef.color, isText: true};
				}
			});
		});
		return statMap;
	}

	GetAllStrategyTradeData() {
		// find the trade for this strategy from this.activeTrades just return the first trade
		const tradeMap = {};
		this.strategies.forEach(strategy => {
			if (strategy.lastTrade) {
				tradeMap[`${strategy.label}_TradePrice`] = {value: strategy.lastTrade.price.toFixed(2), color: Color.white, isText: true};
			}
			else {
				tradeMap[`${strategy.label}_TradePrice`] = {value: 0, color: Color.white, isText: true};
			}
		});
		return tradeMap;
	}

	GetCumulativeData() {
		const finColor = Color.RGB(255, 133, 133);
		if (this.IsCompactMode) {
			return {
				NetPOS: {value: this.cumulativeData.dealQty, color: finColor, isText: true},
				NetClosePL: {value: this.cumulativeData.dealClosePL.toFixed(2), color: finColor, isText: true},
				NetOpenPL: {value: this.cumulativeData.dealOpenPL.toFixed(2), color: finColor, isText: true},
				Net: {value: this.net.toFixed(2), color: finColor, isText: true},
				NAV: {value: this.NAV.toFixed(2), color: finColor, isText: true},
				NAVMax: {value: this.NAVMax.toFixed(2), color: finColor, isText: true},
				NAVDrawDownPts: {value: this.NAVDrawDown.toFixed(2), color: finColor, isText: true},
				MaxDrawDownPts: {value: this.MaxDrawDown.toFixed(2), color: finColor, isText: true},
				NAV_Trade: {value: this.NAV_Trade.toFixed(2), color: finColor, isText: true},
				NAV_TradeMax: {value: this.NAV_TradeMax.toFixed(2), color: finColor, isText: true},
				NAV_TradeDrawDownPts: {value: this.NAV_TradeDrawDown.toFixed(2), color: finColor, isText: true},
				NAV_TradeMaxDrawDownPts: {value: this.NAV_TradeMaxDrawDown.toFixed(2), color: finColor, isText: true}
			};
		}
		return {
			NetPOS: {value: this.cumulativeData.dealQty, color: finColor, isText: true},
			NetValue: {value: this.cumulativeData.dealVal.toFixed(2), color: finColor, isText: true},
			NetCommission: {value: this.cumulativeData.dealCommission.toFixed(2), color: finColor, isText: true},
			NetClosePL: {value: this.cumulativeData.dealClosePL.toFixed(2), color: finColor, isText: true},
			NetOpenPL: {value: this.cumulativeData.dealOpenPL.toFixed(2), color: finColor, isText: true},
			Net: {value: this.net.toFixed(2), color: finColor, isText: true},
			NAV: {value: this.NAV.toFixed(2), color: finColor, isText: true},
			NAVMax: {value: this.NAVMax.toFixed(2), color: finColor, isText: true},
			NAVDrawDownPts: {value: this.NAVDrawDown.toFixed(2), color: finColor, isText: true},
			MaxDrawDownPts: {value: this.MaxDrawDown.toFixed(2), color: finColor, isText: true},
			NAV_Trade: {value: this.NAV_Trade.toFixed(2), color: finColor, isText: true},
			NAV_TradeMax: {value: this.NAV_TradeMax.toFixed(2), color: finColor, isText: true},
			NAV_TradeDrawDownPts: {value: this.NAV_TradeDrawDown.toFixed(2), color: finColor, isText: true},
			NAV_TradeMaxDrawDownPts: {value: this.NAV_TradeMaxDrawDown.toFixed(2), color: finColor, isText: true}
		};
	}

	GetAllOutputData() {
		const acumData = this.GetCumulativeData();
		const sideData = this.GetAllStrategySides();
		const statsData = this.GetAllStrategyStats();
		const tradeData = this.GetAllStrategyTradeData();
		const paramsData = this.GetAllStrategyParams();
		return Object.assign({}, acumData, sideData, statsData, tradeData, paramsData);
	}

	WriteHeader() {
		if (this.dataFilename !== "") {
			this.fileHandle = new File(`${this.dataFilename}`);
			if (this.fileHandle) {
				this.fileHandle.open( "wt" );
				this.fileHandle.writeln("OpenDate,OpenTime,OpenPrice,CloseDate,CloseTime,ClosePrice,Side,Qty,Time in Deal, Trade P&L, Total P&L, NAV, NAVMax, NAVDrawDownPts, MaxDrawDownPts, NAV_Trade, NAV_TradeMax, NAV_TradeDrawDownPts, NAV_TradeMaxDrawDownPts ");
				this.fileHandle.flush();
			}
		}
	}

	// this.fileHandle.writeln("OpenDate,OpenTime,Strategy,Side,OrderTag,OrderType,Qty,Price,Total P&L, NAV");
	// orderTrade.id
	// id: -1,
	// rawTime: cTrackData.rawTime,
	// strategy: this.label,
	// side: this.cSide,
	// orderTag: "OPEN",
	// orderType: "MARKET",
	// qty: posSign * dealQty,
	// price: 0,
	// tradeStatus: "NEW",
	// fillQty: 0,
	// fillPrice: 0,
	// lastRawTime: cTrackData.rawTime,
	DumpData() {
		if (this.completedTrades.length > 0 && this.dataFilename !== "" && this.fileHandle) {
			// compile CSV line of trades


			for (let ndx = 0; ndx < this.completedTrades.length; ndx++) {
				const trade = this.completedTrades[ndx];
				if (trade.orderTag === 'OPEN') {
					this.openTrade = trade;
				}
				else {
					const closeTrade = trade;
					// I already have openTrade, and trade (closeTrade)
					const openTime = TradeEngine.ConvertEpochToLocal(this.openTrade.lastRawTime);
					const closeTime = TradeEngine.ConvertEpochToLocal(closeTrade.lastRawTime);
					const dTime = (closeTrade.lastRawTime - this.openTrade.lastRawTime)/60;
					const tradePL = this.net - (this.lastCloseNet == null ? 0 : this.lastCloseNet);
					const line = `${openTime},${this.openTrade.fillPrice},${closeTime},${closeTrade.fillPrice},${this.openTrade.side},${this.openTrade.fillQty},${dTime},${tradePL},${this.net},${this.NAV},${this.NAVMax},${this.NAVDrawDown},${this.MaxDrawDown},${this.NAV_Trade},${this.NAV_TradeMax},${this.NAV_TradeDrawDown},${this.NAV_TradeMaxDrawDown}`;
					this.fileHandle.writeln(line);
					this.fileHandle.flush();
					this.lastCloseNet = this.net;
					// this.lastCloseWinning = this.net;
					// this.lastCloseLosing = this.net;
				}
			}
			// this.completedTrades.forEach(trade => {
			// if (trade.orderTag === 'OPEN') {
			// openTrade = trade;
			// }
			// else {
			// // I already have openTrade, and trade (closeTrade)
			// const openTime = TradeEngine.ConvertEpochToLocal(openTrade.lastRawTime);
			// const closeTime = TradeEngine.ConvertEpochToLocal(trade.lastRawTime);
			// let line = `${openTime},${openTrade.fillPrice},${trade.side},${trade.orderTag},${trade.orderType},${trade.fillQty},${trade.fillPrice}`;
			// line += `,${this.net},${this.NAV}`;
			// this.fileHandle.writeln(line);
			// this.fileHandle.flush();
			// }
			// });
			this.completedTrades = [];
		}

	}

	CloseDataFile() {
		if (this.dataFilename !== "" && this.fileHandle) {
			this.fileHandle.close();
		}
	}

	static ConvertEpochToLocal(epochTime) {
		const date = new Date(epochTime * 1000); // Convert to milliseconds
		return date.toLocaleString();  // Returns local time (adjusted for DST)
	}

}


/***********************************************************************************************************
 ****************************************************  STRATEGIES ******************************************
 ***********************************************************************************************************/

class StrategySADX extends Strategy {
	constructor(studyCollection, qty, qtyPct, aum, multiplier, tag) {
		super(studyCollection, qty, qtyPct, aum, multiplier);
		this.label = StrategySADX.Label();
		this.tag = tag;

		this.colors = {
			lightPink: Color.RGB(255, 182, 193),
			hotPink: Color.RGB(255, 105, 180),
			forestGreen: Color.RGB(34, 139, 34),
			darkYellow: Color.RGB(190, 190, 0),
			lavender: Color.RGB(238, 130, 238),
			lavender2: Color.RGB(230, 100, 250),
			lightGreen: Color.RGB(144, 238, 144),
			neutralGray: Color.RGB(155,155,155),
			midnightBlue: Color.RGB(25, 25, 65),
			GR1: Color.RGB(128, 128, 128),
			GR2: Color.RGB(96, 160, 96),
			GR3: Color.RGB(64, 192, 64),
			GR4: Color.RGB(32, 224, 32),
			GR5: Color.RGB(0, 255, 0)
		}

		// Initialize the sides in this strategy
		const sideDefs = [
			{ side: "ALL", color: Color.RGB(255, 100, 0), enable: true}  // cumulative stats
			//,{ side: "1", color: this.colors.hotPink, enable: true}
			,{ side: "-1.1", color: this.colors.forestGreen, enable: true}
			,{ side: "-1.2", color: this.colors.darkYellow, enable: true}
		];
		this.InitSideDefs(sideDefs);

		this.vars = [{}, {}];

	}

	// Override the method canOpen from Strategy. This is called every tick to check if a trade can be opened
	// This method returns the Side (this.cSide will be updated). Side != 0 indicates that there is signal
	CanOpen(trackData) {
		const cStudy = this.studyCollection.studies[0];
		if (!cStudy) {
			return 0;
		}

		if (this.pSide !== 0) return 0;

		return cStudy[`${this.tag}_SADX_Side`] ?? 0;
	}

	// Override the method canClose from Strategy
	CanClose(trade, trackData) {
		// if Close price already determined, just update price
		if( trade && trade.price &&  trade.price > 0)
		{
			return cClose;
		}

		const cStudy = this.studyCollection.studies[0];
		const side = cStudy[`${this.tag}_SADX_Side`] ?? 0;

		if (side !== 0 && this.cSide !== side) return cClose;
		return side === 0 ? cClose : 0;
	}

	static Label() {
		return "SADX";
	}


	GetMonitorVar() {
		const cStudy = this.studyCollection.studies[0];
		const levels = this.studyCollection.levelsGrid;
		const sTag = `${this.tag}_SADX`;
		const studiesToMonitor = [
			{label: `${sTag}_Side`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_ADX`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_ADXBias`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_PriceMA`, color: this.colors.lightGreen, plotType: PLOTTYPE_LINE, isText: false},
			{label: `${sTag}_GuideMA`, color: this.colors.lavender, plotType: PLOTTYPE_LINE, isText: false},
			{label: `${sTag}_GuideUB`, color: this.colors.lavender, plotType: PLOTTYPE_LINE, plotStyle: PS_DOT, lineThickness: 2, isText: false},
			{label: `${sTag}_GuideLB`, color: this.colors.lavender, plotType: PLOTTYPE_LINE, plotStyle: PS_DOT, lineThickness: 2, isText: false},
			{label: `${sTag}_ADXTrigger`, color: this.colors.lavender, plotType: PLOTTYPE_LINE, plotStyle: PS_DOT, lineThickness: 2, isText: false},
			{label: `${sTag}_StopBias`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_MarketTrend`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_MaxDownATR`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_BarsSinceExit`, color: this.colors.darkYellow, isText: true},
			{label: `${sTag}_ShockScore`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_ShockDownATR`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_ShockUpATR`, color: this.colors.lightGreen, isText: true},
			{label: `${sTag}_ShockPullbackATR`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_ShockRangeATR`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_Chop`, color: this.colors.hotPink, isText: true},
			{label: `${sTag}_StopReason`, color: this.colors.hotPink, isText: true}
		];
		// const gridToMonitor = [];
		// if (levels && levels.length > 0) {
		// 	levels.forEach((level, ndx) => {
		// 		gridToMonitor.push({label: `${level}`, color: this.colors.GR1, plotType: PLOTTYPE_LINE, plotStyle: PS_DOT, lineThickness: 2, isText: false})
		// 	});
		// }
		// concat gridToMonitor and studiesToMonitor into toMonitor array, gridToMonitor goes first (top of the array)
		const toMonitor = [
			// ...gridToMonitor,
			...studiesToMonitor
		];
		const varsToMonitor = {};
		varsToMonitor['.'] = {value: '', isText: true};  // <----- Empty line
		varsToMonitor['----ADXTREND vars -----'] = {value: '----------------', isText: true};
		const defColor = this.colors.darkYellow;
		for (let ndx = 0; ndx < toMonitor.length; ndx++) {
			const item = toMonitor[ndx];
			const isText = item.isText ?? false;
			const color = item.color ?? defColor;
			const plotType = item.plotType ?? PLOTTYPE_LINE;
			const plotStyle = item.plotStyle ?? PS_SOLID;
			const lineThickness = item.lineThickness ?? 1;
			const val = item.value ?? cStudy[item.label];
			varsToMonitor[item.label] = {value: val, isText: isText, color: color,
				plotType: plotType, plotStyle: plotStyle, lineThickness: lineThickness};
		}
		varsToMonitor['--------------------------------------'] = {value: '----------------', isText: true};
		return varsToMonitor;
	}
}
