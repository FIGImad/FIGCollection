<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        preloadEnabled="true"  : IIS sends a fake request to warm up the app as soon as the worker
                                 process starts, without waiting for real traffic.
        Requires the app pool to have startMode="AlwaysRunning" (set in IIS Manager or
        applicationHost.config — it cannot be set from web.config).
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\FIGAutoTraderAdminSvc.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!--
        doAppInitAfterRestart="true"  : re-runs initialization after every app pool recycle.
        The initializationPage is hit by the fake warm-up request.
      -->
      <applicationInitialization doAppInitAfterRestart="true"
                                 skipManagedModules="false"
                                 remapManagedRequestsTo="">
        <add initializationPage="/" />
      </applicationInitialization>
    </system.webServer>
  </location>
</configuration>
