{
  "Global": {
    "VarPath": "C:\\Roots\\FIGServices\\global_vars.json",
    "Vars": {
      "Service_Name": "FIG_AutoTraderSvc",
      "Service_FriendlyName": "AutoTrader Service",
      "Service_Port": 5001,
      "Service_Role": "ATS",
      "Service_Id": "E65B80F8-AC2A-41FB-B7B0-410A937F71B5"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "{{DBConnection_AutoTrader}}"
  },
  "ControllerConfig": {
    "Id": "{{Service_Id}}",
    "Name": "{{Service_FriendlyName}}",
    "ServiceName": "{{Service_Name}}",
    "ServiceType": "SVC",
    "Roles": [
      "{{Service_Role}}"
    ],
    "AuthUsername": "{{Controller_Username}}",
    "AuthPassword": "{{Controller_Password}}",
    "CertThumbPrint": "{{CertThumbprint}}",
    "HostAddress": "{{Controller_Connection}}",
    "AuthURL": "{{Auth_URL}}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:{{Service_Port}}"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 2147483647
    }
  },
  "LogFile": {
    "MinLevel": "Debug",
    "LogPath": "{{Log_Path}}{{Service_Name}}-.txt",
    "AppName": "{{Service_Name}}",
    "LogAPICalls": false
  },
  "Jwt": {
    "Key": "{{Jwt_Key}}",
    "Issuer": "{{Jwt_Issuer}}",
    "Audience": "{{Jwt_Audience}}"
  },
  "EventMonitor": {
    "ConnectionString": "{{DBConnection_AutoTrader}}",
    "EventTable": "Event"
  },
  "AutoTradeSettings": {
    "OpenSignalExpiryMinutes": 5,
    "CloseSignalExpiryMinutes": 5
  }
}