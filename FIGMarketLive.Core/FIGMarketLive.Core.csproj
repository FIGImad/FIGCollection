<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Database/*.sql" />
    <ProjectReference Include="../FIG.Studies.Common/FIG.Studies.Common.csproj" />
    <!-- Compile the exact service loader, without referencing the trading service host. -->
    <Compile Include="../FIGSignalSvc/Plugins/*.cs" Link="Plugins/%(Filename)%(Extension)" />
    <Compile Include="../FIGSignalSvc/Services/StudyCheckpointStore.cs" Link="Checkpoints/StudyCheckpointStore.cs" />
    <Compile Include="../FIGSignalSvc/Services/StudyCheckpointBatch.cs" Link="Checkpoints/StudyCheckpointBatch.cs" />
    <Compile Include="../FIGPriceCsvConverter/Converter.cs" Link="Import/Converter.cs" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
